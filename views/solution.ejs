<%- include('partials/header', { title: 'Giải pháp giáo dục STEM tổng thể - VSIA' }) %>

<section class="page-hero">
  <div class="page-hero-bg">
    <% if (solutionHeroImage) { %><img src="<%= solutionHeroImage %>" alt=""><% } %>
  </div>
  <div class="page-hero-overlay"></div>
  <div class="page-hero-inner">
    <span class="hero-pill"><%= hero.heroBadge %></span>
    <h1><%= hero.heroTitleLine1 %><% if (hero.heroTitleLine2) { %> <%= hero.heroTitleLine2 %><% } %></h1>
    <p class="lead"><%= hero.heroSubtitle %></p>
    <div class="page-hero-ctas">
      <a class="btn btn-primary" href="#" data-open-contact><%= hero.heroCtaText %></a>
      <a class="btn btn-ghost" href="#he-sinh-thai">Xem hệ sinh thái</a>
    </div>
    <div class="page-hero-badges">
      <span class="badge-pill">Đồng bộ chương trình – thiết bị – con người</span>
      <span class="badge-pill">Bám sát Chương trình GDPT 2018</span>
      <span class="badge-pill">Triển khai từ trường đến tỉnh</span>
    </div>
  </div>
</section>

<section class="section" id="giai-phap-4-phan">
  <div class="container">
    <h2 class="section-title">GIẢI PHÁP GIÁO DỤC STEM TỔNG THỂ, TOÀN DIỆN</h2>

    <div class="solution-showcase">
      <div class="visual-card">
        <div class="visual-card-bg">
          <% if (solutionImage) { %><img src="<%= solutionImage %>" alt="Giải pháp giáo dục STEM tổng thể VSIA"><% } %>
        </div>
        <div class="visual-card-overlay"></div>
        <div class="visual-top">
          <span class="visual-badge">STEM INNOVATION</span>
        </div>
        <div class="visual-icons">
          <div class="vi"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="5" y="4" width="14" height="16" rx="2"/><path d="M9 9h6M9 13h6"/></svg></div>
          <div class="vi"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="4" y="9" width="16" height="10" rx="2"/><path d="M8 9V6a4 4 0 018 0v3"/></svg></div>
          <div class="vi"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0116 0"/></svg></div>
        </div>
        <div class="visual-bottom">
          <h3>Chương trình STEM Innovation</h3>
          <p>Đào tạo giáo viên, chuyển giao chương trình và thiết bị theo mô hình đồng bộ trên toàn quốc.</p>
        </div>
      </div>

      <div class="solution-timeline">
        <div class="solution-timeline-item">
          <span class="solution-timeline-number">1</span>
          <div class="solution-timeline-content">
            <h3>Chương trình giáo dục STEM phổ cập đại trà</h3>
            <p>Bộ S3 STEM KIT — chương trình đóng gói đồng bộ, bám sát Chương trình GDPT 2018, có thể triển khai diện rộng.</p>
          </div>
        </div>
        <div class="solution-timeline-item">
          <span class="solution-timeline-number">2</span>
          <div class="solution-timeline-content">
            <h3>Chương trình học STEM AI Robotics</h3>
            <p>Ứng dụng hệ thống Robot VEX, phát triển tư duy thiết kế và lập trình cho học sinh.</p>
          </div>
        </div>
        <div class="solution-timeline-item">
          <span class="solution-timeline-number">3</span>
          <div class="solution-timeline-content">
            <h3>Tư vấn phòng thực hành STEM (STEM LAB)</h3>
            <p>Tư vấn thiết kế, thi công lắp đặt và xây dựng chương trình vận hành phòng Lab. <a href="/tu-van-phong-lab">Xem chi tiết →</a></p>
          </div>
        </div>
        <div class="solution-timeline-item">
          <span class="solution-timeline-number">4</span>
          <div class="solution-timeline-content">
            <h3>Đồng hành phong trào giáo dục STEM địa phương</h3>
            <p>Hỗ trợ triển khai và tham gia các cuộc thi về STEM, KHKT tại địa phương. <a href="/ngay-hoi-cuoc-thi">Xem chi tiết →</a></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-alt" id="he-sinh-thai" style="position:relative; overflow:hidden;">
  <%- include('partials/section-glow-divider') %>
  <div class="container">
    <h2 class="section-title">HỆ SINH THÁI GIÁO DỤC STEM</h2>
    <p class="section-subtitle">Bốn trụ cột vận hành song song, tạo thành một hệ sinh thái giáo dục STEM bền vững cho nhà trường.</p>

    <div class="eco-grid">
      <div class="eco-card">
        <% if (ecoMovementImage) { %>
          <div class="eco-thumb"><img src="<%= ecoMovementImage %>" alt="Xây dựng phong trào"></div>
        <% } else { %>
          <div class="eco-icon"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3.2"/><path d="M2.5 20a6.5 6.5 0 0113 0"/><circle cx="17.5" cy="9" r="2.6"/><path d="M15 20a5 5 0 018.5-3.6"/></svg></div>
        <% } %>
        <h3>Xây dựng phong trào</h3>
        <p>Giáo viên dạy, học sinh học tập - sáng tạo, phụ huynh đồng hành.</p>
      </div>
      <div class="eco-card">
        <% if (ecoEquipmentImage) { %>
          <div class="eco-thumb"><img src="<%= ecoEquipmentImage %>" alt="Đầu tư trang thiết bị"></div>
        <% } else { %>
          <div class="eco-icon"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="4" width="16" height="16" rx="3"/><path d="M4 10h16M10 10v10"/></svg></div>
        <% } %>
        <h3>Đầu tư trang thiết bị</h3>
        <p>Phòng thực hành STEM (STEM LAB) đạt chuẩn, phù hợp từng cấp học.</p>
      </div>
      <div class="eco-card">
        <% if (ecoCompetitionImage) { %>
          <div class="eco-thumb"><img src="<%= ecoCompetitionImage %>" alt="Các cuộc thi"></div>
        <% } else { %>
          <div class="eco-icon"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 21h8M12 17v4M6 4h12l-1 6a5 5 0 01-10 0L6 4z"/><path d="M6 6H3a3 3 0 003 3M18 6h3a3 3 0 01-3 3"/></svg></div>
        <% } %>
        <h3>Các cuộc thi</h3>
        <p>Tổ chức cuộc thi tại địa phương, tham gia cuộc thi quốc gia, quốc tế.</p>
      </div>
      <div class="eco-card">
        <% if (ecoTrainingImage) { %>
          <div class="eco-thumb"><img src="<%= ecoTrainingImage %>" alt="Tập huấn, đào tạo giáo viên"></div>
        <% } else { %>
          <div class="eco-icon"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 10L12 5 2 10l10 5 10-5z"/><path d="M6 12v5c0 1.5 3 3 6 3s6-1.5 6-3v-5"/></svg></div>
        <% } %>
        <h3>Tập huấn, đào tạo giáo viên</h3>
        <p>Nâng cao năng lực giảng dạy STEM, tinh thần đổi mới sáng tạo.</p>
      </div>
    </div>
  </div>
</section>

<% if (projectImages && projectImages.length > 0) { %>
<section class="section project-highlight">
  <div class="container">
    <h2 class="project-highlight-title">DỰ ÁN NỔI BẬT</h2>
    <p class="project-highlight-lead">VSIA là đơn vị triển khai<br><strong>CHƯƠNG TRÌNH TẬP HUẤN STEM INNOVATION PETROVIETNAM</strong></p>

    <div class="project-gallery">
      <% projectImages.forEach((img, i) => { %>
        <div class="project-gallery-item reveal">
          <img src="<%= img.url %>" alt="Dự án nổi bật VSIA <%= i + 1 %>" loading="lazy">
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section section-alt">
  <div class="container">
    <%- include('partials/training-roadmap') %>
  </div>
</section>

<div class="cta-strip">
  <div class="cta-strip-inner">
    <div>
      <h3>Địa phương hoặc nhà trường bạn muốn xây dựng phong trào STEM?</h3>
      <p>VSIA tư vấn mô hình triển khai phù hợp với điều kiện thực tế — từ chương trình, thiết bị đến con người.</p>
    </div>
    <a class="btn btn-white" href="#" data-open-contact>Liên hệ hợp tác</a>
  </div>
</div>

<%- include('partials/footer') %>
