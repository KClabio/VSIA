<%- include('partials/header', { title: 'VSIA - Đào tạo giáo viên STEM Việt Nam', transparentNav: true }) %>

<section class="hero-home">
  <% if (heroImages && heroImages.length > 0) { %>
    <div class="hero-home-bg-slides">
      <% heroImages.forEach((img, i) => { %>
        <div class="hero-home-bg-slide <%= i === 0 ? 'active' : '' %>" style="background-image: url('<%= img.url %>');"></div>
      <% }) %>
    </div>
    <div class="hero-home-overlay"></div>
  <% } else { %>
    <div class="hero-home-bg"></div>
  <% } %>
  <div class="hexlayer"><svg width="100%" height="100%"><rect width="100%" height="100%" fill="url(#hexpat)"/></svg></div>
  <div class="hero-home-inner">
    <div class="hero-home-copy">
      <span class="eyebrow"><%= hero.heroBadge %></span>
      <h1 class="hero-wordmark"><%= hero.heroTitleLine1 %></h1>
      <p class="sub sub-lg"><%= hero.heroSubtitle %></p>
      <div class="hero-home-cta">
        <button type="button" class="btn btn-primary btn-lg" data-open-contact>Liên hệ tư vấn ngay →</button>
        <a href="/khoa-hoc" class="btn btn-ghost btn-lg">Khoá học</a>
      </div>
    </div>
  </div>
</section>

<section class="section about-us-section" id="ve-vsia">
  <div class="about-us-deco-bg" aria-hidden="true"></div>
  <div class="wrap" style="position:relative; z-index:2;">
    <div class="center reveal">
      <span class="eyebrow">Về VSIA</span>
      <h2 class="h-sec">Sứ mệnh · Tầm nhìn · Giá trị cốt lõi</h2>
    </div>

    <div class="about-vsia-grid" style="margin-top:44px;">
      <div class="av-card reveal">
        <div class="av-item">
          <div class="av-item-head">
            <div class="av-ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none"/></svg></div>
            <h3><span class="av-num">1.</span> Sứ mệnh</h3>
          </div>
          <p>Kiến tạo hệ sinh thái giáo dục STEM cho nhà trường, giáo viên và học sinh Việt Nam, nuôi dưỡng tư duy sáng tạo, năng lực thực hành và bản lĩnh hội nhập.</p>
        </div>

        <div class="av-divider"></div>

        <div class="av-item">
          <div class="av-item-head">
            <div class="av-ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z"/><circle cx="12" cy="12" r="3.2"/></svg></div>
            <h3><span class="av-num">2.</span> Tầm nhìn</h3>
          </div>
          <p>Trở thành học viện tiên phong trong giáo dục STEM và công nghệ số tại Việt Nam, tạo ra giá trị bền vững và vươn tầm tri thức quốc tế.</p>
        </div>

        <div class="av-divider"></div>

        <div class="av-item">
          <div class="av-item-head">
            <h3><span class="av-num">3.</span> Giá trị cốt lõi</h3>
          </div>
          <div class="av-values-grid">
            <div class="av-value">
              <div class="av-value-ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.5.4.85 1.03.85 1.7v.5h5.5v-.5c0-.67.35-1.3.85-1.7A6 6 0 0 0 12 3Z"/></svg></div>
              <span>Đổi mới &amp; Sáng tạo</span>
            </div>
            <div class="av-value">
              <div class="av-value-ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.83 2.83-2.83-.7-.7-2.83L14.7 6.3Z"/></svg></div>
              <span>Chất lượng &amp; Hiệu quả</span>
            </div>
            <div class="av-value">
              <div class="av-value-ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8.5 13.5 5 17l2 2 3.5-3.5M17 12l-2.5 2.5M6 8l3-3 3 3-3 3-3-3ZM17 6l-3 3 3 3 3-3-3-3Z"/></svg></div>
              <span>Tận tâm &amp; Đồng hành</span>
            </div>
            <div class="av-value">
              <div class="av-value-ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
              <span>Trách nhiệm &amp; Nhân văn</span>
            </div>
          </div>
        </div>
      </div>

      <div class="why-vsia-card reveal">
        <h3 class="why-vsia-title">Vì sao chọn VSIA?</h3>

        <div class="why-item">
          <div class="why-ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2 4 5v6c0 5 3.4 8.7 8 11 4.6-2.3 8-6 8-11V5l-8-3Z"/><path d="m9 12 2 2 4-4"/></svg></div>
          <div class="why-body">
            <h4>Năng lực quản trị dự án cấp quốc gia</h4>
            <p>Là đơn vị điều phối Chương trình tập huấn STEM Innovation Petrovietnam, VSIA khẳng định uy tín và năng lực triển khai các dự án giáo dục quy mô lớn theo tiêu chuẩn khắt khe.</p>
          </div>
        </div>

        <div class="why-item">
          <div class="why-ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="m18 8 .9 1.9 2.1.3-1.5 1.5.35 2.1-1.85-1-1.85 1 .35-2.1L15 10.2l2.1-.3L18 8Z"/></svg></div>
          <div class="why-body">
            <h4>Hội đồng cố vấn và khoa học</h4>
            <p>Mọi chương trình đào tạo và giải pháp của VSIA đều được bảo chứng bởi Hội đồng cố vấn gồm các giáo sư, phó giáo sư, tiến sĩ và thạc sĩ giàu kinh nghiệm, đảm bảo chiều sâu học thuật và cập nhật xu hướng quốc tế.</p>
          </div>
        </div>

        <div class="why-item">
          <div class="why-ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 3h2a1 1 0 0 1 1 1v1.2a1.5 1.5 0 0 0 2.6 1l.85-.85a1 1 0 0 1 1.4 0l1.4 1.4a1 1 0 0 1 0 1.4l-.85.85a1.5 1.5 0 0 0 1 2.6H19a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-1.2a1.5 1.5 0 0 0-1 2.6l.85.85a1 1 0 0 1 0 1.4l-1.4 1.4a1 1 0 0 1-1.4 0l-.85-.85a1.5 1.5 0 0 0-2.6 1V21a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1v-1.2a1.5 1.5 0 0 0-2.6-1l-.85.85a1 1 0 0 1-1.4 0l-1.4-1.4a1 1 0 0 1 0-1.4l.85-.85a1.5 1.5 0 0 0-1-2.6H1a1 1 0 0 1-1-1v-2a1 1 0 0 1 1-1h1.2a1.5 1.5 0 0 0 1-2.6l-.85-.85a1 1 0 0 1 0-1.4l1.4-1.4a1 1 0 0 1 1.4 0l.85.85a1.5 1.5 0 0 0 2.6-1V4a1 1 0 0 1 1-1Z" opacity="0"/><path d="M4 8v8l8 4 8-4V8l-8-4-8 4Z"/><path d="M4 8l8 4 8-4M12 12v8"/></svg></div>
          <div class="why-body">
            <h4>Hệ sinh thái giải pháp đồng bộ</h4>
            <p>VSIA không chỉ cung cấp công cụ mà còn giải quyết bài toán giáo dục một cách triệt để thông qua mô hình tích hợp: Thiết kế không gian - Xây dựng chương trình - Đào tạo con người - Vận hành hiệu quả.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section biz" id="linh-vuc-hoat-dong">
  <div class="wrap">
    <div class="center reveal">
      <span class="eyebrow">Lĩnh vực hoạt động</span>
    </div>
    <div class="biz-mask reveal"><div class="bigword">STEM</div></div>

    <div class="linhvuc-grid">
      <a href="/khoa-hoc" class="linhvuc-card lv-1 reveal">
        <div class="linhvuc-media">
          <div class="imgph">
            <% if (bizTeacherImage) { %><img src="<%= bizTeacherImage %>" alt="Đào tạo & bồi dưỡng giáo viên STEM">
            <% } else { %><div class="hexlayer"><svg width="100%" height="100%"><rect width="100%" height="100%" fill="url(#hexpat)"/></svg></div><div class="cam"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2Z"/><circle cx="12" cy="13" r="4"/></svg>Ảnh tập huấn giáo viên</div><% } %>
          </div>
          <div class="linhvuc-ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
        </div>
        <div class="linhvuc-body">
          <h3>Đào tạo &amp; Bồi dưỡng GV</h3>
          <span class="linhvuc-more">Tìm hiểu thêm →</span>
        </div>
      </a>

      <a href="/ngay-hoi-cuoc-thi" class="linhvuc-card lv-2 reveal">
        <div class="linhvuc-media">
          <div class="imgph">
            <% if (bizEventsImage) { %><img src="<%= bizEventsImage %>" alt="Tổ chức & thẩm định sự kiện, cuộc thi STEM">
            <% } else { %><div class="hexlayer"><svg width="100%" height="100%"><rect width="100%" height="100%" fill="url(#hexpat)"/></svg></div><div class="cam"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2Z"/><circle cx="12" cy="13" r="4"/></svg>Ảnh ngày hội STEM</div><% } %>
          </div>
          <div class="linhvuc-ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4Z"/><path d="M17 5h3a2 2 0 0 1-2 4M7 5H4a2 2 0 0 0 2 4"/></svg></div>
        </div>
        <div class="linhvuc-body">
          <h3>Tổ chức &amp; Thẩm định sự kiện</h3>
          <span class="linhvuc-more">Tìm hiểu thêm →</span>
        </div>
      </a>

      <a href="/tu-van-phong-lab" class="linhvuc-card lv-3 reveal">
        <div class="linhvuc-media">
          <div class="imgph">
            <% if (bizLabImage) { %><img src="<%= bizLabImage %>" alt="Thiết kế & chuyển giao chương trình giáo dục STEM">
            <% } else { %><div class="hexlayer"><svg width="100%" height="100%"><rect width="100%" height="100%" fill="url(#hexpat)"/></svg></div><div class="cam"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2Z"/><circle cx="12" cy="13" r="4"/></svg>Ảnh phòng STEM Lab</div><% } %>
          </div>
          <div class="linhvuc-ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 3h6M10 3v5.5L4.8 19a1.4 1.4 0 0 0 1.2 2h12a1.4 1.4 0 0 0 1.2-2L14 8.5V3"/><path d="M7.2 15h9.6"/></svg></div>
        </div>
        <div class="linhvuc-body">
          <h3>Thiết kế chương trình giáo dục</h3>
          <span class="linhvuc-more">Tìm hiểu thêm →</span>
        </div>
      </a>
    </div>
  </div>
</section>

<section class="section" id="chuong-trinh">
  <div class="wrap">
    <div class="center reveal">
      <span class="eyebrow">Chương trình đào tạo</span>
      <h2 class="h-sec">Các khoá đào tạo giáo viên STEM</h2>
      <p class="lead-new">Do VSIA tổ chức, dành cho giáo viên các cấp trên toàn quốc.</p>
    </div>

    <% if (featuredCourses.length === 0) { %>
      <p class="empty-state" style="margin-top:44px;">Chưa có khoá học nào. Chạy <code>node seed.js</code> để thêm dữ liệu mẫu.</p>
    <% } else { %>
      <div class="course-grid" style="margin-top:44px;">
        <% featuredCourses.forEach(course => { %>
          <div class="reveal"><%- include('partials/course-card', { course }) %></div>
        <% }) %>
      </div>
    <% } %>

    <div class="section-cta">
      <a href="/khoa-hoc" class="btn btn-primary">Xem tất cả</a>
    </div>
  </div>
</section>

<section class="section" style="background:var(--mist);">
  <div class="wrap">
    <div class="center reveal">
      <span class="eyebrow">Hình ảnh</span>
      <h2 class="h-sec">Dự án STEM nổi bật</h2>
    </div>

    <% if (galleryItems.length === 0) { %>
      <p class="empty-state" style="margin-top:44px;">Chưa có ảnh/video, thêm ở trang quản trị (<code>/admin/thu-vien</code>).</p>
    <% } else { %>
      <div class="gallery-marquee reveal" style="margin-top:44px;">
        <button type="button" class="carousel-btn gallery-marquee-btn" data-marquee-prev aria-label="Ảnh trước">‹</button>
        <div class="gallery-marquee-track">
          <% [...galleryItems, ...galleryItems].forEach((item) => { %>
            <div class="gallery-marquee-item">
              <% if (item.type === 'image') { %>
                <img src="<%= item.filePath %>" alt="<%= item.title %>">
              <% } else { %>
                <video src="<%= item.filePath %>" muted loop autoplay playsinline></video>
              <% } %>
              <span><%= item.title %></span>
            </div>
          <% }) %>
        </div>
        <button type="button" class="carousel-btn gallery-marquee-btn" data-marquee-next aria-label="Ảnh tiếp theo">›</button>
      </div>
      <div class="section-cta" style="margin-top:36px;">
        <a href="/hinh-anh" class="btn btn-primary">Xem tất cả →</a>
      </div>
    <% } %>
  </div>
</section>

<section class="section" id="tin-tuc">
  <div class="wrap">
    <div class="center reveal">
      <span class="eyebrow">Tin tức &amp; bài viết</span>
      <h2 class="h-sec">Hoạt động nổi bật</h2>
    </div>

    <% if (latestArticles.length === 0) { %>
      <p class="empty-state" style="margin-top:44px;">Chưa có bài viết nào.</p>
    <% } else { %>
      <div class="gallery-marquee article-marquee reveal" style="margin-top:44px;">
        <button type="button" class="carousel-btn gallery-marquee-btn" data-marquee-prev aria-label="Bài trước">‹</button>
        <div class="gallery-marquee-track article-marquee-track">
          <% [...latestArticles, ...latestArticles].forEach((article) => { %>
            <div class="article-marquee-item"><%- include('partials/article-card', { article }) %></div>
          <% }) %>
        </div>
        <button type="button" class="carousel-btn gallery-marquee-btn" data-marquee-next aria-label="Bài tiếp theo">›</button>
      </div>
    <% } %>

    <div class="section-cta">
      <a href="/tin-tuc" class="btn btn-primary">Xem tất cả</a>
    </div>
  </div>
</section>

<section class="section team-section" id="doi-ngu">
  <div class="wrap">
    <div class="center reveal">
      <span class="eyebrow">Đội ngũ</span>
      <h2 class="h-sec">Hội đồng chuyên gia</h2>
      <p class="lead-new">Đội ngũ cố vấn chuyên môn đồng hành cùng VSIA trong các chương trình giáo dục STEM.</p>
    </div>

    <% if (expertMembers.length === 0) { %>
      <p class="empty-state" style="margin-top:44px;">Chưa có thông tin Hội đồng chuyên gia. Thêm ở trang quản trị (<code>/admin/doi-ngu</code>).</p>
    <% } else { %>
      <div class="gallery-marquee expert-marquee reveal" style="margin-top:44px;">
        <button type="button" class="carousel-btn gallery-marquee-btn" data-marquee-prev aria-label="Chuyên gia trước">‹</button>
        <div class="gallery-marquee-track expert-marquee-track">
          <% [...expertMembers, ...expertMembers].forEach((member) => { %>
            <div class="expert-marquee-item">
              <%- include('partials/person-card', { member }) %>
            </div>
          <% }) %>
        </div>
        <button type="button" class="carousel-btn gallery-marquee-btn" data-marquee-next aria-label="Chuyên gia tiếp theo">›</button>
      </div>
    <% } %>
  </div>
</section>

<section class="section partners">
  <div class="wrap center">
    <span class="eyebrow reveal">Đối tác đồng hành</span>
    <h2 class="h-sec reveal">Các đơn vị, tổ chức đồng hành cùng VSIA</h2>

    <% if (partners.length === 0) { %>
      <p class="empty-state" style="margin-top:38px;">Chưa có đối tác nào. Thêm ở trang quản trị (<code>/admin/doi-tac</code>).</p>
    <% } else { %>
      <div class="plogos reveal" style="margin-top:38px;">
        <% partners.forEach(partner => { %>
          <%- include('partials/partner-tile', { name: partner.name, logo: partner.logo }) %>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<section class="section cta" id="lien-he">
  <div class="hexlayer"><svg width="100%" height="100%"><rect width="100%" height="100%" fill="url(#hexpat)"/></svg></div>
  <div class="wrap cta-inner reveal">
    <h2>Sẵn sàng đưa STEM đến với địa phương của bạn</h2>
    <p>VSIA tư vấn, thiết kế và đồng hành triển khai giải pháp giáo dục STEM toàn diện — từ đề án đến đánh giá.</p>
    <div class="cta-actions">
      <a href="#" class="btn btn-primary" data-open-contact>Liên hệ tư vấn →</a>
      <a href="/ngay-hoi-cuoc-thi" class="btn btn-ghost">Xem lịch hoạt động</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
