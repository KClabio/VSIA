    </div>
    <div class="hero-wave-layer hero-wave-mid">
      <svg viewBox="0 0 1440 120" preserveAspectRatio="none"><path d="M0,70 C120,40 240,40 360,70 C480,100 600,100 720,70 C840,40 960,40 1080,70 C1200,100 1320,100 1440,70 L1440,120 L0,120 Z"></path></svg>
      <svg viewBox="0 0 1440 120" preserveAspectRatio="none"><path d="M0,70 C120,40 240,40 360,70 C480,100 600,100 720,70 C840,40 960,40 1080,70 C1200,100 1320,100 1440,70 L1440,120 L0,120 Z"></path></svg>
