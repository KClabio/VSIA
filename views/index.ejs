<section class="section partners">
  <div class="wrap center">
    <span class="eyebrow reveal"><%= hero.homePartnersEyebrow %></span>
    <h2 class="h-sec reveal"><%= hero.homePartnersTitle %></h2>

    <% if (partners.length === 0) { %>
      <p class="empty-state" style="margin-top:38px;"><%= hero.homePartnersEmpty %></p>
    <% } else { %>
      <%
        const normalizePartnerName = (name) => (name || '')
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .toLowerCase();
        const partnerPriority = [
          'petro', 'petrovietnam', 's3', 'kc', 'edupark', 'kdi', 'ha an',
          'stem for vn', 'stem for vietnam', 'nexta', 'teky', 'aig',
        ];
        const partnerRank = (partner) => {
          const name = normalizePartnerName(partner.name);
          const rank = partnerPriority.findIndex((keyword) => name.includes(keyword));
          return rank === -1 ? partnerPriority.length : rank;
        };
        const orderedPartners = [...partners].sort((a, b) => partnerRank(a) - partnerRank(b));
        const featuredPartner = orderedPartners.find((partner) => {
          const name = normalizePartnerName(partner.name);
          return name.includes('petro') || name.includes('petrovietnam');
        });
        const standardPartners = orderedPartners.filter((partner) => partner !== featuredPartner);
      %>
      <div class="plogos reveal" style="margin-top:38px;">
        <% if (featuredPartner) { %>
          <%- include('partials/partner-tile', { name: featuredPartner.name, logo: featuredPartner.logo, featured: true }) %>
        <% } %>
        <% standardPartners.forEach(partner => { %>
          <%- include('partials/partner-tile', { name: partner.name, logo: partner.logo, featured: false }) %>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

