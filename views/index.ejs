    <div class="cta-actions">
      <a href="mailto:taphuan@vsia.edu.vn" class="btn btn-primary">Liên hệ tư vấn →</a>
      <a href="/ngay-hoi-cuoc-thi" class="btn btn-ghost">Xem lịch hoạt động</a>
    </div>
  </div>
</section>

