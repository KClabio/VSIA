<%- include('partials/header', { title: 'VSIA - Đào tạo giáo viên STEM Việt Nam' }) %>

<section class="hero">
  <div class="container hero-inner">
    <span class="hero-badge">CHƯƠNG TRÌNH ĐÀO TẠO GIÁO VIÊN STEM</span>
    <h1>KIẾN TẠO NGUỒN NHÂN LỰC<br><span class="highlight">STEM VIỆT NAM</span></h1>
    <p>Nền tảng kết nối chuyên gia và giáo viên trong các chương trình bồi dưỡng, đào tạo giáo dục STEM.</p>
    <a href="/khoa-hoc" class="btn btn-hero">Xem khoá học</a>
  </div>
</section>

<section class="section section-alt" id="giai-phap-teaser">
  <div class="container" style="text-align:center;">
    <h2 class="section-title">GIẢI PHÁP GIÁO DỤC STEM TỔNG THỂ</h2>
    <p class="section-subtitle">Từ đào tạo giáo viên, tư vấn thiết kế phòng Lab đến tổ chức ngày hội - cuộc thi STEM, VSIA đồng hành cùng nhà trường và địa phương xây dựng phong trào giáo dục STEM bền vững.</p>
    <a href="/giai-phap" class="btn btn-primary">Xem giải pháp tổng thể</a>
  </div>
</section>

<section class="section" id="chuong-trinh">
  <div class="container">
    <h2 class="section-title">CHƯƠNG TRÌNH ĐÀO TẠO</h2>
    <p class="section-subtitle">Các khoá đào tạo giáo viên STEM do VSIA tổ chức, dành cho giáo viên các cấp trên toàn quốc.</p>

    <% if (featuredCourses.length === 0) { %>
      <p class="empty-state">Chưa có khoá học nào. Chạy <code>node seed.js</code> để thêm dữ liệu mẫu.</p>
    <% } else { %>
      <div class="course-grid">
        <% featuredCourses.forEach(course => { %>
          <%- include('partials/course-card', { course }) %>
        <% }) %>
      </div>
    <% } %>

    <div class="section-cta">
      <a href="/khoa-hoc" class="btn btn-primary">Xem tất cả</a>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <h2 class="section-title">HÌNH ẢNH HOẠT ĐỘNG</h2>

    <% if (galleryItems.length === 0) { %>
      <p class="empty-state">Chưa có ảnh/video, thêm ở trang quản trị (<code>/admin/thu-vien</code>).</p>
    <% } else { %>
      <div class="gallery-grid">
        <% const galleryClasses = ['gallery-large', '', '', 'gallery-wide']; %>
        <% galleryItems.forEach((item, i) => { %>
          <div class="gallery-item <%= galleryClasses[i] || '' %>">
            <% if (item.type === 'image') { %>
              <img src="<%= item.filePath %>" alt="<%= item.title %>">
            <% } else { %>
              <video src="<%= item.filePath %>" muted loop autoplay playsinline></video>
            <% } %>
            <span><%= item.title %></span>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<section class="section">
  <div class="container" style="text-align:center;">
    <h2 class="section-title">ĐỐI TÁC ĐỒNG HÀNH</h2>
    <div class="partner-badges">
      <span class="partner-badge">Petrovietnam</span>
      <span class="partner-badge">VNU University of Science (HUS)</span>
      <span class="partner-badge">Học viện Sáng tạo S3</span>
      <span class="partner-badge">STEM &amp; Coding</span>
      <span class="partner-badge">Teky</span>
      <span class="partner-badge">CETT</span>
      <span class="partner-badge">Nexta</span>
      <span class="partner-badge">AIG</span>
      <span class="partner-badge">Robot STEAM Việt Nam</span>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
