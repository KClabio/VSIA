<%- include('partials/head', { pageTitle: course ? 'Sửa khoá học' : 'Thêm khoá học mới', active: 'khoa-hoc' }) %>

<h1 class="page-title"><%= course ? 'Sửa khoá học' : 'Thêm khoá học mới' %></h1>

<% if (error) { %><p class="form-error"><%= error %></p><% } %>

<form method="POST" enctype="multipart/form-data"
      action="<%= course ? '/admin/khoa-hoc/' + course._id + '/sua' : '/admin/khoa-hoc/moi' %>"
      class="admin-form">

  <label>Tiêu đề
    <input type="text" name="title" value="<%= course ? course.title : '' %>" required>
  </label>

  <label>Mô tả
    <textarea name="description" rows="4" required><%= course ? course.description : '' %></textarea>
  </label>

  <div class="admin-form-row">
    <label>Đơn vị tổ chức
      <input type="text" name="provider" value="<%= course ? course.provider : 'VSIA' %>">
    </label>
    <label>Danh mục
      <input type="text" name="category" value="<%= course ? course.category : 'STEM' %>">
    </label>
  </div>

  <div class="admin-form-row">
    <label class="checkbox-label">
      <input type="checkbox" name="isFree" <%= (!course || course.isFree) ? 'checked' : '' %>>
      Miễn phí
    </label>
    <label>Giá (đ, nếu không miễn phí)
      <input type="number" name="price" min="0" value="<%= course ? course.price : 0 %>">
    </label>
    <label>Đánh giá (0-5)
      <input type="number" name="rating" min="0" max="5" step="0.1" value="<%= course ? course.rating : 0 %>">
    </label>
  </div>

  <div class="admin-form-row">
    <label>Giảng viên phụ trách (tên hiển thị công khai)
      <input type="text" name="instructor" placeholder="Vd: TS. Lê Thị Tú Anh" value="<%= course ? course.instructor : '' %>">
    </label>
    <label>Gán tài khoản giáo viên (để tính thống kê)
      <select name="instructorUser">
        <option value="">— Chưa gán —</option>
        <% teachers.forEach(t => { %>
          <option value="<%= t._id %>" <%= (course && course.instructorUser && String(course.instructorUser) === String(t._id)) ? 'selected' : '' %>><%= t.name %></option>
        <% }) %>
      </select>
    </label>
  </div>

  <div class="admin-form-row">
    <label>Thời gian học
      <input type="text" name="studyPeriod" placeholder="Vd: 07/06/2026 - 30/08/2026" value="<%= course ? course.studyPeriod : '' %>">
    </label>
    <label>Ngày thi dự kiến
      <input type="text" name="examDate" placeholder="Vd: 13/09/2026 - 20/09/2026" value="<%= course ? course.examDate : '' %>">
    </label>
  </div>

  <label>Ảnh đại diện <% if (course && course.image) { %>(đang có, chọn file mới để thay)<% } %>
    <input type="file" name="image" accept="image/png,image/jpeg,image/webp,image/gif">
  </label>
  <% if (course && course.image) { %>
    <img src="<%= course.image %>" alt="" class="admin-preview-image">
  <% } %>

  <label>Thêm tài liệu (có thể chọn nhiều file)
    <input type="file" name="materials" multiple>
  </label>

  <% if (course && course.materials && course.materials.length > 0) { %>
    <div class="admin-materials-list">
      <p>Tài liệu đã có:</p>
      <ul>
        <% course.materials.forEach(m => { %>
          <li>
            <a href="<%= m.filePath %>" target="_blank">📄 <%= m.name %></a>
            <form action="/admin/khoa-hoc/<%= course._id %>/tai-lieu/<%= m._id %>/xoa" method="POST" class="inline-form" onsubmit="return confirm('Xoá tài liệu này?');">
              <button type="submit" class="btn-link-danger">Xoá</button>
            </form>
          </li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <div class="admin-form-actions">
    <a href="/admin/khoa-hoc" class="btn btn-ghost">Huỷ</a>
    <button type="submit" class="btn btn-primary"><%= course ? 'Lưu thay đổi' : 'Tạo khoá học' %></button>
  </div>
</form>

<%- include('partials/foot') %>
