<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' - Quản trị VSIA' : 'Quản trị - VSIA' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,500&family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/theme.css">
</head>
<body>

<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
  <linearGradient id="lg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#38b6f1"/><stop offset="1" stop-color="#1a8fd1"/></linearGradient>

  <g id="i-grid"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></g>
  <g id="i-book"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></g>
  <g id="i-trend"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></g>
  <g id="i-file"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8M8 17h8M8 9h2"/></g>
  <g id="i-image"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></g>
  <g id="i-users"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></g>
  <g id="i-link"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></g>
  <g id="i-chat"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8z"/></g>
  <g id="i-lock"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></g>
  <g id="i-gear"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></g>
  <g id="i-home"><path d="M3 9.5 12 3l9 6.5V20a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z"/></g>
  <g id="i-award"><circle cx="12" cy="8" r="6"/><path d="M15.5 13.5 17 22l-5-3-5 3 1.5-8.5"/></g>
  <g id="i-shield"><path d="M12 2 4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5z"/></g>
  <g id="i-clip"><path d="M21.44 11.05 12.25 20.24a5 5 0 0 1-7.07-7.07l9.19-9.19a3.5 3.5 0 0 1 4.95 4.95L9.64 18.36a2 2 0 0 1-2.83-2.83l8.49-8.49"/></g>
  <g id="i-star"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14l-5-4.87 6.91-1.01z"/></g>
  <g id="i-search"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></g>
  <g id="i-bell"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></g>
  <g id="i-chev"><polyline points="9 18 15 12 9 6"/></g>
  <g id="i-play"><circle cx="12" cy="12" r="10"/><path d="M10 8l6 4-6 4z"/></g>
</defs></svg>

<%
  const ADMIN_BREADCRUMB_GROUP = {
    dashboard: 'Tổng quan',
    'khoa-hoc': 'Đào tạo và bồi dưỡng', 'tien-do': 'Đào tạo và bồi dưỡng', 'video-khoa-hoc': 'Đào tạo và bồi dưỡng',
    'bai-viet': 'Nội dung & Giới thiệu', 'thu-vien': 'Nội dung & Giới thiệu', 'doi-ngu': 'Nội dung & Giới thiệu', 'doi-tac': 'Nội dung & Giới thiệu',
    'lien-he': 'Khách hàng & Người dùng', 'nguoi-dung': 'Khách hàng & Người dùng',
    'cai-dat': 'Hệ thống',
  };
  const breadcrumbGroup = ADMIN_BREADCRUMB_GROUP[active] || 'Tổng quan';
%>

  <div class="admin-shell">
    <aside class="admin-sidebar" id="adminSidebar">
      <div class="admin-brand">
        <a href="/admin" class="admin-brand-logo"><%- include('../../partials/logo') %></a>
        <div class="admin-brand-sub">TRANG QUẢN TRỊ</div>
      </div>
      <nav class="admin-sidebar-nav">
        <% if (canAccessModule('dashboard')) { %>
        <p class="admin-nav-section-title">Tổng quan</p>
        <a href="/admin" class="<%= active === 'dashboard' ? 'active' : '' %>">
          <svg class="admin-nav-icon"><use href="#i-grid"/></svg> Dashboard
        </a>
        <% } %>

        <% if (canAccessModule('khoa-hoc') || canAccessModule('tien-do') || canAccessModule('video-khoa-hoc')) { %>
        <p class="admin-nav-section-title">Đào tạo và bồi dưỡng</p>
        <% if (canAccessModule('khoa-hoc')) { %>
        <a href="/admin/khoa-hoc" class="<%= active === 'khoa-hoc' ? 'active' : '' %>">
          <svg class="admin-nav-icon"><use href="#i-book"/></svg> Khoá học
        </a>
        <% } %>
        <% if (canAccessModule('video-khoa-hoc')) { %>
        <a href="/admin/video-khoa-hoc" class="<%= active === 'video-khoa-hoc' ? 'active' : '' %>">
          <svg class="admin-nav-icon"><use href="#i-play"/></svg> Video bài giảng
        </a>
        <% } %>
        <% if (canAccessModule('tien-do')) { %>
        <a href="/admin/tien-do" class="<%= active === 'tien-do' ? 'active' : '' %>">
          <svg class="admin-nav-icon"><use href="#i-trend"/></svg> Tiến độ học tập
        </a>
        <% } %>
        <% } %>

        <% if (canAccessModule('bai-viet') || canAccessModule('thu-vien') || canAccessModule('doi-ngu') || canAccessModule('doi-tac')) { %>
        <p class="admin-nav-section-title">Nội dung &amp; Giới thiệu</p>
        <% if (canAccessModule('bai-viet')) { %>
        <a href="/admin/bai-viet" class="<%= active === 'bai-viet' ? 'active' : '' %>">
          <svg class="admin-nav-icon"><use href="#i-file"/></svg> Bài viết &amp; Tin tức
        </a>
        <% } %>
        <% if (canAccessModule('thu-vien')) { %>
        <a href="/admin/thu-vien" class="<%= active === 'thu-vien' ? 'active' : '' %>">
          <svg class="admin-nav-icon"><use href="#i-image"/></svg> Thư viện ảnh/video
        </a>
        <% } %>
        <% if (canAccessModule('doi-ngu')) { %>
        <a href="/admin/doi-ngu" class="<%= active === 'doi-ngu' ? 'active' : '' %>">
          <svg class="admin-nav-icon"><use href="#i-users"/></svg> Đội ngũ chuyên gia
        </a>
        <% } %>
        <% if (canAccessModule('doi-tac')) { %>
        <a href="/admin/doi-tac" class="<%= active === 'doi-tac' ? 'active' : '' %>">
          <svg class="admin-nav-icon"><use href="#i-link"/></svg> Đối tác đồng hành
        </a>
        <% } %>
        <% } %>

        <% if (canAccessModule('lien-he') || canAccessModule('nguoi-dung')) { %>
        <p class="admin-nav-section-title">Khách hàng &amp; Người dùng</p>
        <% if (canAccessModule('lien-he')) { %>
        <a href="/admin/lien-he" class="<%= active === 'lien-he' ? 'active' : '' %>">
          <svg class="admin-nav-icon"><use href="#i-chat"/></svg> Liên hệ tư vấn
        </a>
        <% } %>
        <% if (canAccessModule('nguoi-dung')) { %>
        <a href="/admin/nguoi-dung" class="<%= active === 'nguoi-dung' ? 'active' : '' %>">
          <svg class="admin-nav-icon"><use href="#i-lock"/></svg> Tài khoản hệ thống
        </a>
        <% } %>
        <% } %>

        <% if (canAccessModule('cai-dat')) { %>
        <p class="admin-nav-section-title">Hệ thống</p>
        <a href="/admin/cai-dat" class="<%= active === 'cai-dat' ? 'active' : '' %>">
          <svg class="admin-nav-icon"><use href="#i-gear"/></svg> Cài đặt
        </a>
        <% } %>
      </nav>

      <a href="/" class="admin-sidebar-home-link">
        <svg class="admin-nav-icon"><use href="#i-home"/></svg> Trang chủ
      </a>
    </aside>

    <div class="admin-main">
      <header class="admin-topbar">
        <button class="admin-sidebar-toggle" id="sidebarToggle" aria-label="Mở menu">☰</button>
        <div class="admin-topbar-left">
          <div class="admin-crumb"><%= breadcrumbGroup %> / <b><%= pageTitle %></b></div>
          <h1 class="admin-topbar-title" id="adminTopbarTitle"><%= pageTitle %></h1>
        </div>
        <div class="admin-topbar-right">
          <div class="admin-search-box" id="adminSearchBox">
            <svg class="admin-search-ic"><use href="#i-search"/></svg>
            <input type="text" id="adminSearchInput" placeholder="Tìm kiếm..." aria-label="Tìm kiếm" autocomplete="off">
            <div class="admin-search-results" id="adminSearchResults"></div>
          </div>
          <div class="admin-icon-btn" title="Thông báo" aria-label="Thông báo"><svg><use href="#i-bell"/></svg></div>
          <div class="admin-divider-v"></div>
          <%- include('../../partials/user-menu', { menuContext: 'admin' }) %>
        </div>
      </header>
      <main class="admin-content" id="adminContent">
