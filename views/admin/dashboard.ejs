<%- include('partials/head', { pageTitle: 'Dashboard', active: 'dashboard' }) %>

<div class="admin-page-head">
  <% if (user.role === 'admin') { %>
  <span class="live-indicator" id="liveIndicator"><span class="live-dot"></span> Trực tiếp</span>
  <% } %>
</div>

<div class="adm-stat-grid">
  <% cards.forEach(card => { %>
    <div class="adm-stat-card">
      <div class="adm-stat-top">
        <span class="adm-stat-label"><%= card.label %></span>
        <span class="adm-stat-icon-box <%= card.accent === 'amber' ? 'amber' : '' %>"><svg width="15" height="15"><use href="#<%= card.iconId %>"/></svg></span>
      </div>
      <div class="adm-stat-num"><span data-stat="<%= card.key %>"><%= card.value %></span><% if (card.suffix) { %><sup><%= card.suffix %></sup><% } %></div>
    </div>
  <% }) %>
</div>

<h2 class="adm-section-title">Truy cập nhanh</h2>
<div class="adm-qa-panel">
  <div class="adm-qa-grid">
    <% if (canAccessModule('khoa-hoc')) { %>
    <a href="/admin/khoa-hoc" class="adm-qa-row">
      <span class="adm-qa-icon-box"><svg><use href="#i-book"/></svg></span>
      <span><span class="adm-qa-title">Quản lý khoá học</span><span class="adm-qa-desc">Tạo, sửa, xoá khoá học và tài liệu đính kèm.</span></span>
      <svg class="adm-qa-chev"><use href="#i-chev"/></svg>
    </a>
    <% } %>
    <% if (canAccessModule('tien-do')) { %>
    <a href="/admin/tien-do" class="adm-qa-row">
      <span class="adm-qa-icon-box"><svg><use href="#i-trend"/></svg></span>
      <span><span class="adm-qa-title">Tiến độ học tập</span><span class="adm-qa-desc">Theo dõi tiến trình hoàn thành bài học của học viên.</span></span>
      <svg class="adm-qa-chev"><use href="#i-chev"/></svg>
    </a>
    <% } %>
    <% if (canAccessModule('thu-vien')) { %>
    <a href="/admin/thu-vien" class="adm-qa-row">
      <span class="adm-qa-icon-box"><svg><use href="#i-image"/></svg></span>
      <span><span class="adm-qa-title">Thư viện ảnh/video</span><span class="adm-qa-desc">Quản lý ảnh, video hiển thị ở mục "Hình ảnh hoạt động".</span></span>
      <svg class="adm-qa-chev"><use href="#i-chev"/></svg>
    </a>
    <% } %>
    <% if (canAccessModule('bai-viet')) { %>
    <a href="/admin/bai-viet" class="adm-qa-row">
      <span class="adm-qa-icon-box"><svg><use href="#i-file"/></svg></span>
      <span><span class="adm-qa-title">Quản lý bài viết</span><span class="adm-qa-desc">Tạo, sửa, xoá bài viết hiển thị ở mục "Tin tức".</span></span>
      <svg class="adm-qa-chev"><use href="#i-chev"/></svg>
    </a>
    <% } %>
    <% if (canAccessModule('doi-ngu')) { %>
    <a href="/admin/doi-ngu" class="adm-qa-row">
      <span class="adm-qa-icon-box"><svg><use href="#i-users"/></svg></span>
      <span><span class="adm-qa-title">Ban lãnh đạo &amp; Hội đồng chuyên gia</span><span class="adm-qa-desc">Thêm, sửa ảnh và thông tin thành viên hiển thị ở trang chủ.</span></span>
      <svg class="adm-qa-chev"><use href="#i-chev"/></svg>
    </a>
    <% } %>
    <% if (canAccessModule('doi-tac')) { %>
    <a href="/admin/doi-tac" class="adm-qa-row">
      <span class="adm-qa-icon-box"><svg><use href="#i-link"/></svg></span>
      <span><span class="adm-qa-title">Đối tác đồng hành</span><span class="adm-qa-desc">Thêm, sửa logo và thông tin đối tác hiển thị ở trang chủ.</span></span>
      <svg class="adm-qa-chev"><use href="#i-chev"/></svg>
    </a>
    <% } %>
    <% if (canAccessModule('lien-he')) { %>
    <a href="/admin/lien-he" class="adm-qa-row">
      <span class="adm-qa-icon-box"><svg><use href="#i-chat"/></svg></span>
      <span><span class="adm-qa-title">Liên hệ tư vấn</span><span class="adm-qa-desc">Tiếp nhận, xử lý các yêu cầu tư vấn từ khách hàng.</span></span>
      <svg class="adm-qa-chev"><use href="#i-chev"/></svg>
    </a>
    <% } %>
    <% if (canAccessModule('nguoi-dung')) { %>
    <a href="/admin/nguoi-dung" class="adm-qa-row">
      <span class="adm-qa-icon-box"><svg><use href="#i-lock"/></svg></span>
      <span><span class="adm-qa-title">Quản lý người dùng</span><span class="adm-qa-desc">Cấp hoặc thu hồi quyền quản trị cho tài khoản khác.</span></span>
      <svg class="adm-qa-chev"><use href="#i-chev"/></svg>
    </a>
    <% } %>
    <% if (canAccessModule('cai-dat')) { %>
    <a href="/admin/cai-dat" class="adm-qa-row">
      <span class="adm-qa-icon-box"><svg><use href="#i-gear"/></svg></span>
      <span><span class="adm-qa-title">Cài đặt website</span><span class="adm-qa-desc">Logo, ảnh nền trang chủ, ảnh minh hoạ và tiêu đề đầu trang.</span></span>
      <svg class="adm-qa-chev"><use href="#i-chev"/></svg>
    </a>
    <% } %>
  </div>
</div>

<% if (showContentChart) { %>
<%
  const chartItems = [
    { key: 'courseCount', label: 'Khoá học', value: stats.courseCount, iconId: 'i-book', color: 'var(--adm-accent)' },
    { key: 'articleCount', label: 'Bài viết', value: stats.articleCount, iconId: 'i-file', color: '#7C90F8' },
    { key: 'teamCount', label: 'Đội ngũ', value: stats.teamCount, iconId: 'i-users', color: 'var(--adm-amber)' },
    { key: 'partnerCount', label: 'Đối tác', value: stats.partnerCount, iconId: 'i-link', color: '#C7CEFB' },
    { key: 'mediaCount', label: 'Ảnh/video', value: stats.mediaCount, iconId: 'i-image', color: '#E4D5B8' },
    { key: 'materialCount', label: 'Tài liệu', value: stats.materialCount, iconId: 'i-clip', color: '#EEF0F5' },
  ];
  const rawMax = Math.max(1, ...chartItems.map((i) => i.value));
  function niceCeil(max) {
    if (max <= 5) return 5;
    const magnitude = Math.pow(10, Math.floor(Math.log10(max)));
    const residual = max / magnitude;
    let niceResidual;
    if (residual <= 1) niceResidual = 1;
    else if (residual <= 2) niceResidual = 2;
    else if (residual <= 5) niceResidual = 5;
    else niceResidual = 10;
    return niceResidual * magnitude;
  }
  const axisMax = niceCeil(rawMax);
  const axisTicks = [0, 1, 2, 3, 4, 5].map((i) => Math.round(axisMax * i / 5));

  const totalItems = chartItems.reduce((sum, i) => sum + i.value, 0) || 1;
%>
<h2 class="adm-section-title">Thống kê nội dung</h2>
<div class="adm-content-row">
  <div class="adm-panel">
    <div class="adm-chart-head">
      <div><div class="adm-eyebrow">Thư viện nội dung</div><div class="adm-chart-title">Số lượng theo loại</div></div>
      <div class="adm-chart-total"><b><%= totalItems %></b>mục nội dung</div>
    </div>
    <div class="adm-grid-wrap">
      <div class="adm-grid-lines"><% axisTicks.forEach(() => { %><span></span><% }) %></div>
      <% chartItems.forEach(item => { %>
        <div class="adm-bar-row">
          <div class="adm-bar-label"><svg width="14" height="14"><use href="#<%= item.iconId %>"/></svg><%= item.label %></div>
          <div class="adm-bar-track">
            <div class="adm-bar-fill" data-stat-bar="<%= item.key %>" style="width: <%= Math.round(item.value / axisMax * 100) %>%; background: <%= item.color %>;" title="<%= item.label %>: <%= item.value %>"></div>
          </div>
          <div class="adm-bar-value" data-stat="<%= item.key %>"><%= item.value %></div>
        </div>
      <% }) %>
      <div class="adm-grid-axis"><% axisTicks.forEach(tick => { %><span><%= tick %></span><% }) %></div>
    </div>
  </div>

  <div class="adm-panel">
    <div class="adm-chart-head" style="margin-bottom:12px;"><div><div class="adm-eyebrow">Cơ cấu</div><div class="adm-chart-title">Tỉ trọng nội dung</div></div></div>
    <%
      let donutCursor = 0;
      const donutStops = chartItems.map((item) => {
        const pct = (item.value / totalItems) * 100;
        const start = donutCursor;
        donutCursor += pct;
        return `${item.color} ${start.toFixed(2)}% ${donutCursor.toFixed(2)}%`;
      }).join(', ');
    %>
    <div class="adm-donut-row">
      <div class="adm-donut" style="background: conic-gradient(<%= donutStops %>);">
        <div class="adm-donut-hole">
          <div class="adm-donut-total"><%= totalItems %></div>
          <div class="adm-donut-total-label">mục nội dung</div>
        </div>
      </div>
      <div class="adm-legend">
        <% chartItems.forEach(item => { %>
          <div class="adm-legend-row"><span class="adm-legend-dot" style="background: <%= item.color %>;"></span><%= item.label %><span><%= Math.round(item.value / totalItems * 100) %>%</span></div>
        <% }) %>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    if (window.__adminSSE) window.__adminSSE.close();

    var indicator = document.getElementById('liveIndicator');
    var source = new EventSource('/admin/stats-stream');
    window.__adminSSE = source;

    source.onopen = function () {
      indicator.classList.remove('live-indicator-off');
    };

    source.onerror = function () {
      indicator.classList.add('live-indicator-off');
    };

    var chartKeys = ['courseCount', 'articleCount', 'teamCount', 'partnerCount', 'mediaCount', 'materialCount'];

    source.onmessage = function (event) {
      var stats = JSON.parse(event.data);

      Object.keys(stats).forEach(function (key) {
        document.querySelectorAll('[data-stat="' + key + '"]').forEach(function (el) {
          if (el.textContent === String(stats[key])) return;
          el.textContent = stats[key];
          el.classList.remove('stat-flash');
          void el.offsetWidth;
          el.classList.add('stat-flash');
        });
      });

      var max = Math.max(1, chartKeys.map(function (k) { return stats[k] || 0; }).reduce(function (a, b) { return Math.max(a, b); }, 0));
      chartKeys.forEach(function (key) {
        var bar = document.querySelector('[data-stat-bar="' + key + '"]');
        if (!bar) return;
        var value = stats[key] || 0;
        bar.style.width = Math.round((value / max) * 100) + '%';
        bar.title = bar.title.replace(/: \d+$/, ': ' + value);
      });
    };
  })();
</script>
<% } %>

<%- include('partials/foot') %>
