<%- include('partials/head', { pageTitle: 'Thư viện ảnh/video', active: 'thu-vien' }) %>

<div class="admin-page-head">
  <h1 class="page-title">Thư viện ảnh/video</h1>
  <span class="admin-count-badge"><%= mediaItems.length %> mục đã thêm</span>
</div>
<p class="section-subtitle" style="margin-bottom:30px; text-align:left;">Ảnh/video mới nhất sẽ hiển thị ở mục "Hình ảnh hoạt động" trên trang chủ.</p>

<% if (error) { %><p class="form-error"><%= error %></p><% } %>

<div class="admin-form-row admin-upload-forms">
  <form method="POST" action="/admin/thu-vien/anh" enctype="multipart/form-data" class="admin-form admin-upload-form">
    <h3>Tải ảnh lên</h3>
    <label>Tiêu đề
      <input type="text" name="title" placeholder="Vd: Tập huấn giáo viên">
    </label>
    <label>Chọn ảnh
      <input type="file" name="image" accept="image/png,image/jpeg,image/webp,image/gif" required>
    </label>
    <button type="submit" class="btn btn-primary">Tải ảnh</button>
  </form>

  <form method="POST" action="/admin/thu-vien/video" enctype="multipart/form-data" class="admin-form admin-upload-form">
    <h3>Tải video lên</h3>
    <label>Tiêu đề
      <input type="text" name="title" placeholder="Vd: Robotics trong lớp học">
    </label>
    <label>Chọn video
      <input type="file" name="video" accept="video/mp4,video/webm,video/ogg" required>
    </label>
    <button type="submit" class="btn btn-primary">Tải video</button>
  </form>
</div>

<% if (mediaItems.length === 0) { %>
  <p class="empty-state">Chưa có ảnh/video nào. Dùng 2 form phía trên để tải lên.</p>
<% } else { %>
  <div class="admin-media-grid">
    <% mediaItems.forEach(item => { %>
      <div class="admin-media-card">
        <% if (item.type === 'image') { %>
          <img src="<%= item.filePath %>" alt="<%= item.title %>">
        <% } else { %>
          <video src="<%= item.filePath %>" controls></video>
        <% } %>
        <p><%= item.title %></p>
        <div class="admin-media-card-actions">
          <details class="admin-media-edit">
            <summary class="btn btn-icon">✏️ Sửa</summary>
            <form action="/admin/thu-vien/<%= item._id %>/sua" method="POST" enctype="multipart/form-data" class="admin-media-edit-form">
              <label>Tiêu đề
                <input type="text" name="title" value="<%= item.title %>" required>
              </label>
              <label>Thay <%= item.type === 'image' ? 'ảnh' : 'video' %> (bỏ trống nếu chỉ đổi tiêu đề)
                <input type="file" name="file" accept="<%= item.type === 'image' ? 'image/png,image/jpeg,image/webp,image/gif' : 'video/mp4,video/webm,video/ogg' %>">
              </label>
              <button type="submit" class="btn btn-primary btn-block">Lưu thay đổi</button>
            </form>
          </details>
          <form action="/admin/thu-vien/<%= item._id %>/xoa" method="POST" class="inline-form" data-confirm-title="Bạn có chắc xoá mục này?" data-confirm-name="<%= item.title %>">
            <button type="submit" class="btn btn-icon btn-danger">🗑 Xoá</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('partials/foot') %>
