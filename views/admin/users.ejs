<%- include('partials/head', { pageTitle: 'Quản lý người dùng', active: 'nguoi-dung' }) %>

<h1 class="page-title">Quản lý người dùng</h1>

<% if (error) { %><p class="form-error"><%= error %></p><% } %>
<% if (success) { %><p class="form-success">Đã tạo tài khoản người dùng.</p><% } %>

<details class="settings-page-block" open style="margin-bottom:24px;">
  <summary>Thêm tài khoản người dùng</summary>
  <div class="settings-page-form">
    <form method="POST" action="/admin/nguoi-dung" class="admin-form">
      <div class="admin-form-row">
        <label>Họ tên
          <input type="text" name="name" value="<%= form.name || '' %>" required>
        </label>
        <label>Email
          <input type="email" name="email" value="<%= form.email || '' %>" required>
        </label>
      </div>
      <div class="admin-form-row">
        <label>Mật khẩu
          <input type="password" name="password" minlength="6" required>
        </label>
        <label>Xác nhận mật khẩu
          <input type="password" name="confirmPassword" minlength="6" required>
        </label>
      </div>
      <label>Vai trò
        <select name="role">
          <% ROLES.forEach(r => { %>
            <option value="<%= r %>" <%= (form.role || 'hocvien') === r ? 'selected' : '' %>><%= ROLE_LABELS[r] %></option>
          <% }) %>
        </select>
      </label>
      <div class="admin-form-actions">
        <button type="submit" class="btn btn-primary">Tạo tài khoản</button>
      </div>
    </form>
  </div>
</details>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Họ tên</th>
        <th>Email</th>
        <th>Vai trò</th>
        <th>Ngày tham gia</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach(u => { %>
        <tr>
          <td><%= u.name %></td>
          <td><%= u.email %></td>
          <td>
            <span class="role-badge <%= u.role === 'admin' ? 'role-badge-admin' : '' %>">
              <%= ROLE_LABELS[u.role] || u.role %>
            </span>
          </td>
          <td><%= new Date(u.createdAt).toLocaleDateString('vi-VN') %></td>
          <td class="admin-table-actions">
            <% if (String(u._id) === String(user._id)) { %>
              <span class="empty-state">(Tài khoản của bạn)</span>
            <% } else { %>
              <form action="/admin/nguoi-dung/<%= u._id %>/vai-tro" method="POST" class="inline-form" data-confirm-title="Bạn có chắc đổi vai trò của tài khoản này?" data-confirm-name="<%= u.name %>" data-confirm-neutral="1" data-confirm-label="Đồng ý">
                <select name="role">
                  <% ROLES.forEach(r => { %>
                    <option value="<%= r %>" <%= u.role === r ? 'selected' : '' %>><%= ROLE_LABELS[r] %></option>
                  <% }) %>
                </select>
                <button type="submit" class="btn btn-icon">Cập nhật</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('partials/foot') %>
