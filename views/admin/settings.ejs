<%- include('partials/head', { pageTitle: 'Nội dung website', active: 'cai-dat' }) %>

<h1 class="page-title">Nội dung website</h1>
<p class="admin-scope-note">
  ℹ️ Mục này quản lý phần <strong>tĩnh</strong> của website (logo, ảnh nền, tiêu đề đầu trang), nhóm theo từng trang công khai. Nội dung có danh sách riêng — Khoá học, Video bài giảng, Bài viết, Đội ngũ, Đối tác — sửa trực tiếp ở mục tương ứng bên sidebar.
</p>

<% if (error) { %><p class="form-error"><%= error %></p><% } %>

<% const pageByKey = {}; pages.forEach((p) => { pageByKey[p.key] = p; }); %>

<div style="max-width:1040px;">

  <h2 class="admin-settings-group-title">Trang chủ</h2>

  <details class="settings-page-block" id="logo">
    <summary>🖼️ Logo trang web</summary>
    <div class="settings-page-form">
      <% if (settings.logo) { %>
        <div class="admin-logo-preview">
          <img src="<%= settings.logo %>" alt="Logo hiện tại">
        </div>
        <form action="/admin/cai-dat/logo/xoa" method="POST" class="inline-form" onsubmit="return confirm('Xoá logo và quay về logo chữ mặc định?');" style="margin-bottom:20px;">
          <button type="submit" class="btn btn-ghost">Xoá logo, dùng lại chữ "VSIA"</button>
        </form>
      <% } else { %>
        <p class="empty-state" style="text-align:left; margin-bottom:16px;">Chưa có logo ảnh — đang hiển thị chữ "VSIA" mặc định.</p>
      <% } %>

      <form method="POST" enctype="multipart/form-data" action="/admin/cai-dat/logo">
        <label>Chọn file logo mới (nên dùng PNG nền trong suốt, giữ nguyên màu logo)
          <input type="file" name="logo" accept="image/png,image/jpeg,image/webp,image/gif" required>
        </label>
        <div class="admin-form-actions">
          <button type="submit" class="btn btn-primary"><%= settings.logo ? 'Thay logo' : 'Tải logo lên' %></button>
        </div>
      </form>
    </div>
  </details>

  <details class="settings-page-block" id="hero-image">
    <summary>🌄 Ảnh nền Hero trang chủ (slideshow)</summary>
    <div class="settings-page-form">
      <p class="section-subtitle" style="margin-bottom:16px; text-align:left;">Có thể thêm nhiều ảnh — trang chủ sẽ tự động chuyển lần lượt giữa các ảnh này. Chưa có ảnh nào sẽ dùng nền gradient màu thương hiệu.</p>

      <% if (settings.heroImages && settings.heroImages.length > 0) { %>
        <div class="admin-hero-slides-grid" style="margin-bottom:20px;">
          <% settings.heroImages.forEach((img, i) => { %>
            <div class="admin-hero-slide-item">
              <img src="<%= img.url %>" alt="Ảnh nền Hero <%= i + 1 %>">
              <form action="/admin/cai-dat/anh-hero/<%= img._id %>/xoa" method="POST" class="inline-form" onsubmit="return confirm('Xoá ảnh này khỏi slideshow?');">
                <button type="submit" class="btn btn-icon btn-danger">🗑 Xoá</button>
              </form>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="empty-state" style="text-align:left; margin-bottom:16px;">Chưa có ảnh — đang dùng nền gradient xanh thương hiệu.</p>
      <% } %>

      <form method="POST" enctype="multipart/form-data" action="/admin/cai-dat/anh-hero">
        <label>Thêm ảnh vào slideshow (ảnh rộng, nên tối màu hoặc đủ tương phản để chữ trắng đọc rõ)
          <input type="file" name="heroImage" accept="image/png,image/jpeg,image/webp,image/gif" required>
        </label>
        <div class="admin-form-actions">
          <button type="submit" class="btn btn-primary">+ Thêm ảnh</button>
        </div>
      </form>
    </div>
  </details>

  <details class="settings-page-block" id="biz-images-home">
    <summary>📷 Ảnh khu vực "Lĩnh vực hoạt động"</summary>
    <div class="settings-page-form">
      <p class="section-subtitle" style="margin-bottom:20px; text-align:left;">Ảnh minh hoạ cho 2 tab còn lại trên trang chủ. Chưa có ảnh sẽ hiện hoạ tiết thay thế.</p>
      <%- include('partials/settings-image-block', { id: 'img-teacher', label: 'Đào tạo giáo viên', value: settings.bizTeacherImage, actionUrl: '/admin/cai-dat/anh-linh-vuc/teacher', deleteUrl: '/admin/cai-dat/anh-linh-vuc/teacher/xoa' }) %>
      <%- include('partials/settings-image-block', { id: 'img-robotics', label: 'Robotics AI', hint: 'Ảnh này cũng được dùng làm ảnh banner đầu trang Khoá học.', value: settings.bizRoboticsImage, actionUrl: '/admin/cai-dat/anh-linh-vuc/robotics', deleteUrl: '/admin/cai-dat/anh-linh-vuc/robotics/xoa' }) %>
    </div>
  </details>

  <div id="hero-home"><%- include('partials/settings-hero-form', { page: pageByKey['home'] }) %></div>

  <h2 class="admin-settings-group-title">Giải pháp</h2>

  <details class="settings-page-block" id="solution-hero-image">
    <summary>🌄 Ảnh banner đầu trang Giải pháp</summary>
    <div class="settings-page-form">
      <%- include('partials/settings-image-block', { id: 'img-solution-hero', label: 'Ảnh banner', value: settings.solutionHeroImage, actionUrl: '/admin/cai-dat/anh-linh-vuc/solution-hero', deleteUrl: '/admin/cai-dat/anh-linh-vuc/solution-hero/xoa' }) %>
    </div>
  </details>

  <details class="settings-page-block" id="solution-image">
    <summary>🧩 Ảnh minh hoạ "Giải pháp giáo dục STEM tổng thể"</summary>
    <div class="settings-page-form">
      <p class="section-subtitle" style="margin-bottom:16px; text-align:left;">Hiển thị ở khối "STEM Innovation", cạnh danh sách 4 nội dung giải pháp.</p>
      <% if (settings.solutionImage) { %>
        <div class="admin-logo-preview">
          <img src="<%= settings.solutionImage %>" alt="Ảnh minh hoạ giải pháp" style="max-height:220px;">
        </div>
        <form action="/admin/cai-dat/anh-giai-phap/xoa" method="POST" class="inline-form" onsubmit="return confirm('Xoá ảnh minh hoạ này?');" style="margin-bottom:20px;">
          <button type="submit" class="btn btn-ghost">Xoá ảnh</button>
        </form>
      <% } else { %>
        <p class="empty-state" style="text-align:left; margin-bottom:16px;">Chưa có ảnh minh hoạ — mục này sẽ để trống trên trang Giải pháp.</p>
      <% } %>

      <form method="POST" enctype="multipart/form-data" action="/admin/cai-dat/anh-giai-phap">
        <label>Chọn ảnh mới (vd: ảnh bộ STEM KIT, sản phẩm thực tế)
          <input type="file" name="solutionImage" accept="image/png,image/jpeg,image/webp,image/gif" required>
        </label>
        <div class="admin-form-actions">
          <button type="submit" class="btn btn-primary"><%= settings.solutionImage ? 'Thay ảnh' : 'Tải ảnh lên' %></button>
        </div>
      </form>
    </div>
  </details>

  <details class="settings-page-block" id="project-images">
    <summary>🏆 Ảnh Dự án nổi bật</summary>
    <div class="settings-page-form">
      <p class="section-subtitle" style="margin-bottom:16px; text-align:left;">Hiển thị ở lưới ảnh khối "DỰ ÁN NỔI BẬT" trên trang Giải pháp. Nên thêm ít nhất 5 ảnh (sự kiện, tập huấn, trao giải...) để lưới ảnh cân đối.</p>

      <% if (settings.projectImages && settings.projectImages.length > 0) { %>
        <div class="admin-hero-slides-grid" style="margin-bottom:20px;">
          <% settings.projectImages.forEach((img, i) => { %>
            <div class="admin-hero-slide-item">
              <img src="<%= img.url %>" alt="Ảnh dự án nổi bật <%= i + 1 %>">
              <form action="/admin/cai-dat/anh-du-an/<%= img._id %>/xoa" method="POST" class="inline-form" onsubmit="return confirm('Xoá ảnh này khỏi lưới ảnh?');">
                <button type="submit" class="btn btn-icon btn-danger">🗑 Xoá</button>
              </form>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="empty-state" style="text-align:left; margin-bottom:16px;">Chưa có ảnh — khối "Dự án nổi bật" sẽ tạm ẩn trên trang Giải pháp.</p>
      <% } %>

      <form method="POST" enctype="multipart/form-data" action="/admin/cai-dat/anh-du-an">
        <label>Thêm ảnh vào lưới
          <input type="file" name="projectImage" accept="image/png,image/jpeg,image/webp,image/gif" required>
        </label>
        <div class="admin-form-actions">
          <button type="submit" class="btn btn-primary">+ Thêm ảnh</button>
        </div>
      </form>
    </div>
  </details>

  <details class="settings-page-block" id="eco-images">
    <summary>🌱 Ảnh khối "Hệ sinh thái giáo dục STEM"</summary>
    <div class="settings-page-form">
      <p class="section-subtitle" style="margin-bottom:20px; text-align:left;">Ảnh cho từng thẻ trong khối 4 thẻ "Hệ sinh thái". Chưa có ảnh sẽ hiện icon thay thế.</p>
      <%- include('partials/settings-image-block', { id: 'img-eco-movement', label: 'Xây dựng phong trào', value: settings.ecoMovementImage, actionUrl: '/admin/cai-dat/anh-linh-vuc/eco-movement', deleteUrl: '/admin/cai-dat/anh-linh-vuc/eco-movement/xoa' }) %>
      <%- include('partials/settings-image-block', { id: 'img-eco-equipment', label: 'Đầu tư trang thiết bị', value: settings.ecoEquipmentImage, actionUrl: '/admin/cai-dat/anh-linh-vuc/eco-equipment', deleteUrl: '/admin/cai-dat/anh-linh-vuc/eco-equipment/xoa' }) %>
      <%- include('partials/settings-image-block', { id: 'img-eco-competition', label: 'Các cuộc thi', value: settings.ecoCompetitionImage, actionUrl: '/admin/cai-dat/anh-linh-vuc/eco-competition', deleteUrl: '/admin/cai-dat/anh-linh-vuc/eco-competition/xoa' }) %>
      <%- include('partials/settings-image-block', { id: 'img-eco-training', label: 'Tập huấn, đào tạo giáo viên', value: settings.ecoTrainingImage, actionUrl: '/admin/cai-dat/anh-linh-vuc/eco-training', deleteUrl: '/admin/cai-dat/anh-linh-vuc/eco-training/xoa' }) %>
    </div>
  </details>

  <div id="hero-giai-phap"><%- include('partials/settings-hero-form', { page: pageByKey['giai-phap'] }) %></div>

  <h2 class="admin-settings-group-title">Thiết kế chương trình giáo dục</h2>

  <details class="settings-page-block" id="lab-image">
    <summary>🌄 Ảnh banner đầu trang</summary>
    <div class="settings-page-form">
      <%- include('partials/settings-image-block', { id: 'img-lab', label: 'Ảnh banner', hint: 'Ảnh này cũng hiện ở thẻ "Tư vấn phòng Lab" trên trang chủ.', value: settings.bizLabImage, actionUrl: '/admin/cai-dat/anh-linh-vuc/lab', deleteUrl: '/admin/cai-dat/anh-linh-vuc/lab/xoa' }) %>
    </div>
  </details>

  <div id="hero-lab-consulting"><%- include('partials/settings-hero-form', { page: pageByKey['lab-consulting'] }) %></div>

  <h2 class="admin-settings-group-title">Tổ chức &amp; Thẩm định sự kiện</h2>

  <details class="settings-page-block" id="events-image">
    <summary>🌄 Ảnh banner đầu trang</summary>
    <div class="settings-page-form">
      <%- include('partials/settings-image-block', { id: 'img-events', label: 'Ảnh banner', hint: 'Ảnh này cũng hiện ở thẻ "Ngày hội & Cuộc thi" trên trang chủ.', value: settings.bizEventsImage, actionUrl: '/admin/cai-dat/anh-linh-vuc/events', deleteUrl: '/admin/cai-dat/anh-linh-vuc/events/xoa' }) %>
    </div>
  </details>

  <div id="hero-stem-events"><%- include('partials/settings-hero-form', { page: pageByKey['stem-events'] }) %></div>

  <h2 class="admin-settings-group-title">Liên hệ</h2>

  <details class="settings-page-block" id="contact-image">
    <summary>🌄 Ảnh banner đầu trang</summary>
    <div class="settings-page-form">
      <%- include('partials/settings-image-block', { id: 'img-contact', label: 'Ảnh banner', value: settings.contactImage, actionUrl: '/admin/cai-dat/anh-linh-vuc/contact', deleteUrl: '/admin/cai-dat/anh-linh-vuc/contact/xoa' }) %>
    </div>
  </details>

  <div id="hero-lien-he"><%- include('partials/settings-hero-form', { page: pageByKey['lien-he'] }) %></div>

</div>

<script>
  (function () {
    function openFromHash() {
      var id = decodeURIComponent(location.hash.replace('#', ''));
      if (!id) return;
      var target = document.getElementById(id);
      if (!target) return;

      // Mở chính nó (nếu là <details>) và toàn bộ <details> cha bên trên (hỗ trợ accordion lồng nhau).
      var self = target.tagName === 'DETAILS' ? target : target.querySelector('details');
      if (self) self.open = true;
      var ancestor = target.parentElement ? target.parentElement.closest('details') : null;
      while (ancestor) {
        ancestor.open = true;
        ancestor = ancestor.parentElement ? ancestor.parentElement.closest('details') : null;
      }

      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    openFromHash();
    window.addEventListener('hashchange', openFromHash);
  })();
</script>

<%- include('partials/foot') %>
