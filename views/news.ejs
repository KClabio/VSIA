<%- include('partials/header', { title: 'Tin tức - VSIA' }) %>

<section class="section">
  <div class="container">
    <div class="news-head">
      <span class="eyebrow">— VSIA</span>
      <h1 class="page-title" style="margin-top:12px; text-align:left;">Tin tức &amp; Bài viết</h1>
      <p class="section-subtitle" style="margin:12px 0 0; text-align:left;">Cập nhật hoạt động, sự kiện và câu chuyện giáo dục STEM từ VSIA cùng các đối tác đồng hành.</p>
    </div>

    <% if (articles.length === 0) { %>
      <p class="empty-state" style="margin-top:40px;">Chưa có bài viết nào.</p>
    <% } else { %>
      <%
        const featured = articles[0]; const rest = articles.slice(1); const highlights = articles.slice(0, 4);
        const featuredDate = new Date(featured.createdAt);
        const featuredDay = String(featuredDate.getDate()).padStart(2, '0');
        const featuredMonth = 'Th' + (featuredDate.getMonth() + 1);
      %>
      <div class="news-layout">
        <div class="news-main">

          <a class="news-featured" href="<%= featured.sourceUrl || ('/tin-tuc/' + featured._id) %>"<% if (featured.sourceUrl) { %> rel="noopener noreferrer nofollow"<% } %>>
            <div class="news-featured-media" <% if (featured.image) { %>style="background-image:url('<%= featured.image %>');"<% } %>>
              <div class="article-date-badge"><span class="article-date-day"><%= featuredDay %></span><span class="article-date-month"><%= featuredMonth %></span></div>
              <% if (featured.category) { %><span class="news-chip"><%= featured.category %></span><% } else { %><span></span><% } %>
              <span class="news-media-ic"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8M8 17h8M8 9h2"/></svg></span>
            </div>
            <div class="news-featured-body">
              <h2><%= featured.title %></h2>
              <p><%= featured.summary %></p>
              <span class="news-read-link">Đọc bài viết <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
            </div>
          </a>

          <% if (rest.length > 0) { %>
            <div class="news-grid">
              <% rest.forEach(article => {
                const cardDate = new Date(article.createdAt);
                const cardDay = String(cardDate.getDate()).padStart(2, '0');
                const cardMonth = 'Th' + (cardDate.getMonth() + 1);
              %>
                <a class="news-card" href="<%= article.sourceUrl || ('/tin-tuc/' + article._id) %>"<% if (article.sourceUrl) { %> rel="noopener noreferrer nofollow"<% } %>>
                  <div class="news-card-media" <% if (article.image) { %>style="background-image:url('<%= article.image %>');"<% } %>>
                    <div class="article-date-badge article-date-badge-sm"><span class="article-date-day"><%= cardDay %></span><span class="article-date-month"><%= cardMonth %></span></div>
                    <% if (article.category) { %><span class="news-chip news-chip-sm"><%= article.category %></span><% } else { %><span></span><% } %>
                    <span class="news-media-ic news-media-ic-sm"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></span>
                  </div>
                  <div class="news-card-body">
                    <h3><%= article.title %></h3>
                    <p><%= article.summary %></p>
                    <span class="news-read-link news-read-link-sm">Xem thêm <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
                  </div>
                </a>
              <% }) %>
            </div>
          <% } %>
        </div>

        <aside class="news-sidebar">
          <h4>Nổi bật</h4>
          <div class="news-sidebar-rule"></div>
          <% highlights.forEach((article, i) => { %>
            <div class="news-side-item">
              <a href="/tin-tuc/<%= article._id %>" class="news-side-thumb" style="<% if (article.image) { %>background-image:url('<%= article.image %>');<% } else { %>background:linear-gradient(150deg, var(--navy-dark), var(--navy2));<% } %>">
                <% if (!article.image) { %><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.7"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg><% } %>
              </a>
              <div class="news-side-text">
                <a href="/tin-tuc/<%= article._id %>"><%= article.title %></a>
                <p><%= new Date(article.createdAt).toLocaleDateString('vi-VN') %></p>
              </div>
            </div>
          <% }) %>
        </aside>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
