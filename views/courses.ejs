<%- include('partials/header', { title: 'Khoá học - VSIA', pageId: 'khoa-hoc' }) %>

<section class="page-hero">
  <div class="page-hero-bg">
    <% if (bizRoboticsImage) { %><img src="<%= bizRoboticsImage %>" alt=""><% } %>
  </div>
  <div class="page-hero-overlay"></div>
  <div class="page-hero-inner">
    <span class="hero-pill"><%- ed('khoahoc.hero.badge', 'Chương trình đào tạo VSIA') %></span>
    <h1><%- ed('khoahoc.hero.title', 'Đào tạo và bồi dưỡng chuyên môn STEM') %></h1>
    <p class="lead"><%- ed('khoahoc.hero.lead', 'Tổ chức các khóa đào tạo, bồi dưỡng nâng cao năng lực sư phạm và làm chủ công nghệ cho đội ngũ cán bộ quản lý, giáo viên các cấp.', { multiline: true }) %></p>
    <div class="page-hero-ctas">
      <a class="btn btn-primary" href="<%= lnk('khoahoc.hero.cta1.link', '#lo-trinh') %>"<%- lnkAttr('khoahoc.hero.cta1.link') %>><%- ed('khoahoc.hero.cta1.label', 'Xem lộ trình đào tạo') %></a>
      <a class="btn btn-ghost" href="#" data-open-contact><%- ed('khoahoc.hero.cta2.label', 'Đăng ký tư vấn') %></a>
    </div>
    <div class="page-hero-badges">
      <span class="badge-pill"><%- ed('khoahoc.hero.badge1', 'Bám sát Chương trình GDPT 2018') %></span>
      <span class="badge-pill"><%- ed('khoahoc.hero.badge2', 'Cơ bản đến chuyên sâu') %></span>
      <span class="badge-pill"><%- ed('khoahoc.hero.badge3', 'Đồng hành cùng Hội đồng Chuyên gia VSIA') %></span>
    </div>
  </div>
</section>

<section class="section section-alt" id="lo-trinh">
  <div class="container">
    <%- include('partials/training-roadmap', { hero: typeof hero === 'undefined' ? null : hero }) %>
  </div>
</section>

<section class="section" id="khoa-hoc-danh-sach">
  <div class="container">
    <h2 class="section-title"><%- ed('khoahoc.list.title', 'KHOÁ HỌC') %></h2>
    <p class="section-subtitle"><%- ed('khoahoc.list.subtitle', 'Danh sách các khoá đào tạo, tập huấn STEM hiện có tại VSIA.', { multiline: true }) %></p>
    <% if (courses.length === 0) { %>
      <p class="empty-state"><%- ed('khoahoc.list.empty1', 'Chưa có khoá học nào. Chạy') %> <code>node seed.js</code> <%- ed('khoahoc.list.empty2', 'để thêm dữ liệu mẫu.') %></p>
    <% } else { %>
      <div class="course-grid">
        <% courses.forEach(course => { %>
          <%- include('partials/course-card', { course }) %>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<% if (courseVideos.length > 0) { %>
<section class="section section-alt" id="thu-vien" style="position:relative; overflow:hidden;">
  <%- include('partials/section-glow-divider') %>
  <div class="container">
    <h2 class="section-title"><%- ed('khoahoc.video.title', 'VIDEO & BÀI GIẢNG MẪU') %></h2>
    <p class="section-subtitle"><%- ed('khoahoc.video.subtitle', 'Tài nguyên tham khảo dành cho giáo viên đang triển khai chương trình STEM tại trường.', { multiline: true }) %></p>

    <div class="video-grid">
      <% courseVideos.forEach((v, i) => { %>
        <a class="video-card <%= i === 0 ? 'video-card-featured' : '' %>" href="<%= v.videoUrl %>" target="_blank" rel="noopener">
          <div class="video-thumb">
            <div class="video-top-row">
              <% if (v.tag) { %><span class="video-chip"><%= v.tag %></span><% } else { %><span></span><% } %>
              <span class="video-play">
                <svg width="<%= i === 0 ? 22 : 16 %>" height="<%= i === 0 ? 22 : 16 %>" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </span>
            </div>
            <div class="video-bottom">
              <h3><%= v.title %></h3>
              <% if (v.description) { %><p><%= v.description %></p><% } %>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<%- include('partials/footer') %>
