<%- include('partials/header', { title: 'Khoá học - VSIA' }) %>

<section class="section">
  <div class="container">
    <div class="center">
      <span class="eyebrow">Chương trình đào tạo</span>
      <h1 class="page-title" style="margin-top:16px;">Khoá học đào tạo STEM</h1>
    </div>

    <% if (courses.length === 0) { %>
      <p class="empty-state">Chưa có khoá học nào. Chạy <code>node seed.js</code> để thêm dữ liệu mẫu.</p>
    <% } else { %>
      <div class="course-grid">
        <% courses.forEach(course => { %>
          <%- include('partials/course-card', { course }) %>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
