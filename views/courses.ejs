<%- include('partials/header', { title: 'Khoá học - VSIA' }) %>

<section class="page-hero">
  <div class="page-hero-bg">
    <% if (bizRoboticsImage) { %><img src="<%= bizRoboticsImage %>" alt=""><% } %>
  </div>
  <div class="page-hero-overlay"></div>
  <div class="page-hero-inner">
    <span class="hero-pill">Chương trình đào tạo VSIA</span>
    <h1>Đào tạo và bồi dưỡng chuyên môn STEM</h1>
    <p class="lead">Tập huấn nâng cao năng lực sư phạm và phương pháp giảng dạy STEM — Khoa học, Công nghệ, Kĩ thuật, Toán cùng AI, Robotics — cho cán bộ quản lý và giáo viên phổ thông.</p>
    <div class="page-hero-ctas">
      <a class="btn btn-primary" href="#lo-trinh">Xem lộ trình đào tạo</a>
      <a class="btn btn-ghost" href="#" data-open-contact>Đăng ký tư vấn</a>
    </div>
    <div class="page-hero-badges">
      <span class="badge-pill">Bám sát Chương trình GDPT 2018</span>
      <span class="badge-pill">Cơ bản đến chuyên sâu</span>
      <span class="badge-pill">Đồng hành cùng Hội đồng Chuyên gia VSIA</span>
    </div>
  </div>
</section>

<section class="section section-alt" id="lo-trinh">
  <div class="container">
    <%- include('partials/training-roadmap') %>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2 class="section-title">KHOÁ HỌC</h2>
    <p class="section-subtitle">Danh sách các khoá đào tạo, tập huấn STEM hiện có tại VSIA.</p>
    <% if (courses.length === 0) { %>
      <p class="empty-state">Chưa có khoá học nào. Chạy <code>node seed.js</code> để thêm dữ liệu mẫu.</p>
    <% } else { %>
      <div class="course-grid">
        <% courses.forEach(course => { %>
          <%- include('partials/course-card', { course }) %>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<% if (courseVideos.length > 0) { %>
<section class="section section-alt" id="thu-vien">
  <div class="container">
    <h2 class="section-title">VIDEO &amp; BÀI GIẢNG MẪU</h2>
    <p class="section-subtitle">Tài nguyên tham khảo dành cho giáo viên đang triển khai chương trình STEM tại trường.</p>

    <div class="video-grid">
      <% courseVideos.forEach((v, i) => { %>
        <a class="video-card <%= i === 0 ? 'video-card-featured' : '' %>" href="<%= v.videoUrl %>" target="_blank" rel="noopener">
          <div class="video-thumb">
            <div class="video-top-row">
              <% if (v.tag) { %><span class="video-chip"><%= v.tag %></span><% } else { %><span></span><% } %>
              <span class="video-play">
                <svg width="<%= i === 0 ? 22 : 16 %>" height="<%= i === 0 ? 22 : 16 %>" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </span>
            </div>
            <div class="video-bottom">
              <h3><%= v.title %></h3>
              <% if (v.description) { %><p><%= v.description %></p><% } %>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<%- include('partials/footer') %>
