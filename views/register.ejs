<%- include('partials/header', { title: 'Đăng ký - VSIA' }) %>

<section class="section auth-section">
  <div class="container auth-container">
    <form class="auth-form" method="POST" action="/dang-ky">
      <h1>Đăng ký tài khoản</h1>
      <p class="auth-subtitle">Dành cho giáo viên tham gia chương trình đào tạo STEM.</p>
      <% if (error) { %><p class="form-error"><%= error %></p><% } %>

      <label>Họ tên
        <input type="text" name="name" value="<%= form.name || '' %>" required autofocus>
      </label>
      <label>Email
        <input type="email" name="email" value="<%= form.email || '' %>" required>
      </label>
      <label>Mật khẩu
        <input type="password" name="password" required minlength="6">
      </label>
      <label>Xác nhận mật khẩu
        <input type="password" name="confirmPassword" required minlength="6">
      </label>

      <button type="submit" class="btn btn-primary btn-block">Đăng ký</button>

      <p class="auth-switch">Đã có tài khoản? <a href="/dang-nhap">Đăng nhập</a></p>
    </form>
  </div>
</section>

<%- include('partials/footer') %>
