<%- include('partials/header', { title: 'Đăng ký - VSIA' }) %>

<section class="auth-section-new">
  <div class="wrap">
    <div class="auth-shell">
      <div class="auth-visual">
        <div class="hexlayer"><svg width="100%" height="100%"><rect width="100%" height="100%" fill="url(#hexpat)"/></svg></div>
        <div class="auth-visual-content">
          <span class="eyebrow" style="color:#7fd8a2;">Tham gia VSIA</span>
          <h2>Đồng hành cùng cộng đồng giáo viên STEM</h2>
          <p>Tạo tài khoản để đăng ký các khoá đào tạo, nhận tài liệu và cập nhật hoạt động STEM mới nhất.</p>
        </div>
      </div>
      <div class="auth-form-side">
        <h1>Đăng ký tài khoản</h1>
        <p class="lead-new">Dành cho giáo viên tham gia chương trình đào tạo STEM.</p>
        <% if (error) { %><p class="form-error"><%= error %></p><% } %>

        <form method="POST" action="/dang-ky">
          <label>Họ tên
            <input type="text" name="name" value="<%= form.name || '' %>" required autofocus>
          </label>
          <label>Email
            <input type="email" name="email" value="<%= form.email || '' %>" required>
          </label>
          <label>Mật khẩu
            <input type="password" name="password" required minlength="6">
          </label>
          <label>Xác nhận mật khẩu
            <input type="password" name="confirmPassword" required minlength="6">
          </label>

          <button type="submit" class="btn btn-primary btn-block">Đăng ký</button>

          <p class="auth-switch">Đã có tài khoản? <a href="/dang-nhap">Đăng nhập</a></p>
        </form>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
