<%- include('partials/header', { title: 'Xác nhận email - VSIA' }) %>

<section class="auth-section-new">
  <div class="auth-deco-bg" aria-hidden="true"></div>
  <div class="wrap">
    <div class="auth-card">
      <div class="auth-card-brand"><%- include('partials/logo') %></div>
      <span class="eyebrow" style="justify-content:center;">Xác nhận email</span>
      <h1>Nhập mã xác nhận</h1>
      <p class="lead-new">VSIA đã gửi mã gồm 6 chữ số tới <strong><%= email %></strong>. Kiểm tra hộp thư (kể cả mục Spam) và nhập mã bên dưới.</p>

      <% if (error) { %><p class="form-error"><%= error %></p><% } %>
      <% if (typeof resent !== 'undefined' && resent) { %><p style="color:#1a8f5a;font-weight:600;margin-bottom:12px;">Đã gửi lại mã mới, vui lòng kiểm tra email.</p><% } %>

      <form method="POST" action="/dang-ky/xac-thuc">
        <label>Mã xác nhận
          <div class="auth-input-wrap">
            <svg class="auth-input-ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <input type="text" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="000000" required autofocus>
          </div>
        </label>
        <button type="submit" class="btn btn-primary btn-block btn-lg">Xác nhận</button>
      </form>

      <form method="POST" action="/dang-ky/gui-lai-ma" style="margin-top:14px;">
        <button type="submit" class="btn btn-ghost btn-block">Gửi lại mã</button>
      </form>

      <p class="auth-switch">Nhập sai email? <a href="/dang-ky">Đăng ký lại</a></p>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
