<%
  // pageId là "mã trang" dùng cho các nội dung riêng của từng trang (tiêu đề SEO, mô tả meta).
  // View nào truyền pageId thì admin sửa được phần SEO của trang đó; view chưa truyền vẫn chạy
  // bình thường với tiêu đề cứng như trước.
  const cePageId = typeof pageId !== 'undefined' && pageId ? pageId : null;
  const ceDefaultTitle = typeof title !== 'undefined' ? title : 'VSIA - Đào tạo giáo viên STEM';
  const ceTitle = cePageId ? txt('seo.' + cePageId + '.title', ceDefaultTitle) : ceDefaultTitle;
  const ceDescription = cePageId ? txt('seo.' + cePageId + '.description', '') : '';
  const ceShareImage = cePageId ? pic('seo.' + cePageId + '.image', null) : null;

%>
<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= ceTitle %></title>
  <% if (ceDescription) { %>
  <meta name="description" content="<%= ceDescription %>">
  <% } %>
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= ceTitle %>">
  <% if (ceDescription) { %>
  <meta property="og:description" content="<%= ceDescription %>">
  <% } %>
  <% if (ceShareImage) { %>
  <meta property="og:image" content="<%= ceShareImage %>">
  <% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,500&family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/theme.css">
</head>
<body>

<% if (siteLogo) { %>
  <div class="site-watermark" aria-hidden="true"><img src="<%= siteLogo %>" alt=""></div>
<% } %>

<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
  <pattern id="hexpat" width="56" height="48" patternUnits="userSpaceOnUse">
    <path d="M28 0 L56 16 L56 48 M28 0 L0 16 L0 48 M0 16 L28 32 L56 16 M28 32 L28 64" fill="none" stroke="currentColor" stroke-width="1.3"/>
  </pattern>
  <linearGradient id="lg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#38b6f1"/><stop offset="1" stop-color="#1a8fd1"/></linearGradient>
</defs></svg>

  <header class="site-header <%= typeof transparentNav !== 'undefined' && transparentNav ? 'nav-transparent' : '' %>" id="siteHeader">
    <div class="container header-inner">
      <a href="/" class="logo"><%- include('logo') %></a>

      <button class="nav-toggle" id="navToggle" aria-label="Mở menu"><span></span><span></span><span></span></button>

      <nav class="main-nav" id="mainNav">
        <a href="<%= lnk('nav.home.link', '/') %>"<%- lnkAttr('nav.home.link') %>><%- ed('nav.home.label', 'TRANG CHỦ') %></a>
        <div class="nav-dropdown">
          <button type="button" class="nav-dropdown-trigger" aria-expanded="false"><%- ed('nav.fields.label', 'LĨNH VỰC HOẠT ĐỘNG') %> <span class="nav-caret">▾</span></button>
          <div class="nav-dropdown-menu">
            <div class="nav-subdropdown">
              <a href="<%= lnk('nav.fields.training.link', '/khoa-hoc') %>" class="nav-subdropdown-link"<%- lnkAttr('nav.fields.training.link') %>><%- ed('nav.fields.training.label', 'ĐÀO TẠO BỒI DƯỠNG CHUYÊN MÔN') %></a>
              <button type="button" class="nav-subdropdown-toggle" aria-label="Mở danh mục con" aria-expanded="false"><span class="nav-caret nav-caret-right">▸</span></button>
              <div class="nav-subdropdown-menu">
                <a href="<%= lnk('nav.fields.webinar.link', '/hoi-thao-truc-tuyen') %>"<%- lnkAttr('nav.fields.webinar.link') %>><%- ed('nav.fields.webinar.label', 'Hội thảo STEM trực tuyến') %></a>
              </div>
            </div>
            <a href="<%= lnk('nav.fields.transfer.link', '/tu-van-phong-lab') %>"<%- lnkAttr('nav.fields.transfer.link') %>><%- ed('nav.fields.transfer.label', 'THIẾT KẾ VÀ CHUYỂN GIAO CHƯƠNG TRÌNH GIÁO DỤC') %></a>
            <a href="<%= lnk('nav.fields.events.link', '/ngay-hoi-cuoc-thi') %>"<%- lnkAttr('nav.fields.events.link') %>><%- ed('nav.fields.events.label', 'TỔ CHỨC NGÀY HỘI & CUỘC THI STEM') %></a>
          </div>
        </div>
        <a href="<%= lnk('nav.solution.link', '/giai-phap') %>"<%- lnkAttr('nav.solution.link') %>><%- ed('nav.solution.label', 'GIẢI PHÁP') %></a>
        <a href="<%= lnk('nav.courses.link', '/khoa-hoc') %>"<%- lnkAttr('nav.courses.link') %>><%- ed('nav.courses.label', 'KHOÁ HỌC') %></a>
        <a href="<%= lnk('nav.news.link', '/tin-tuc') %>"<%- lnkAttr('nav.news.link') %>><%- ed('nav.news.label', 'TIN TỨC') %></a>
        <a href="<%= lnk('nav.cta.link', '/hop-tac') %>" class="nav-cta"<%- lnkAttr('nav.cta.link') %>><%- ed('nav.cta.label', 'Hợp tác') %></a>
      </nav>

      <div class="auth-actions">
        <% if (user) { %>
          <%- include('user-menu', { user, menuContext: 'public' }) %>
        <% } else { %>
          <a href="/dang-nhap" class="btn btn-ghost">Đăng nhập</a>
          <a href="/dang-ky" class="btn btn-primary">Đăng ký</a>
        <% } %>
      </div>
    </div>
  </header>
  <script>
  (function () {
    var header = document.getElementById('siteHeader');
    var inner = header && header.querySelector('.header-inner');
    if (!header || !inner) return;
    var overflowing = inner.scrollWidth > inner.clientWidth + 1;
    header.classList.add('nav-no-anim');
    header.classList.toggle('nav-compact', overflowing);
    requestAnimationFrame(function () {
      requestAnimationFrame(function () { header.classList.remove('nav-no-anim'); });
    });
  })();
  </script>
  <main>
