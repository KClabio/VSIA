      <div class="path-num">4</div>
      <a class="path-card reveal" href="#khoa-hoc-danh-sach">
        <div class="path-icon tint-green">
          <svg viewBox="0 0 24 24" fill="none">
            <rect x="5" y="19" width="14" height="1.8" rx=".9" fill="#0a3d66"/>
