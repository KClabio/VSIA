          </svg>
        </div>
        <h3><%= trainingPrograms[1][0] %></h3>
        <p><%= trainingPrograms[1][1] %></p>
      </a>
    </div>
  </div>

  <div class="path-row">
    <div class="path-node left">
      <a class="path-card reveal" href="#khoa-hoc-danh-sach">
        <div class="path-icon tint-blue">
