<%
  const trainingDefaults = [
    ['Tập huấn, đào tạo kỹ thuật', 'Hướng dẫn giáo viên sử dụng, vận hành và khai thác thiết bị STEM, Robotics, AI trong phòng thực hành.'],
    ['Tổng quan giáo dục STEM trong CTGDPT', 'Trang bị kiến thức nền tảng về giáo dục STEM và định hướng triển khai trong Chương trình giáo dục phổ thông.'],
    ['Thực hành xây dựng các chủ đề dạy học STEM', 'Thực hành thiết kế và tổ chức các chủ đề dạy học STEM gắn với thực tiễn lớp học.'],
    ['Nghiên cứu KHKT trong Giáo dục phổ thông', 'Trang bị phương pháp tổ chức và hướng dẫn học sinh thực hiện nghiên cứu khoa học kỹ thuật.'],
    ['Thực hành các chủ đề nghiên cứu KHKT', 'Thực hành xây dựng đề tài, dự án nghiên cứu khoa học kỹ thuật cùng học sinh.'],
  ];
  const trainingPrograms = trainingDefaults.map((item, index) => [
    (hero && hero['trainingProgram' + (index + 1) + 'Title']) || item[0],
    (hero && hero['trainingProgram' + (index + 1) + 'Text']) || item[1],
  ]);
%>
<% if (typeof showHeading === 'undefined' || showHeading !== false) { %>
  <h2 class="section-title">CÁC CHƯƠNG TRÌNH TẬP HUẤN VÀ ĐÀO TẠO GIÁO VIÊN</h2>
  <p class="section-subtitle">Lộ trình cơ bản đến chuyên sâu, từ kỹ thuật thiết bị đến hướng dẫn học sinh nghiên cứu khoa học.</p>
<% } %>

<div class="path">
  <div class="path-spine"></div>

  <div class="path-row">
    <div class="path-node left">
      <a class="path-card reveal" href="#khoa-hoc-danh-sach">
        <div class="path-icon tint-blue">
          <svg viewBox="0 0 24 24" fill="none">
            <rect x="4" y="3.6" width="2" height="3" rx="1" fill="#1a8fd1"/>
            <circle cx="5" cy="3" r="1.5" fill="#1a8fd1"/>
            <rect x="3" y="7" width="18" height="13" rx="4" fill="#0a3d66"/>
            <circle cx="9" cy="13.5" r="2" fill="#fff"/>
            <circle cx="15" cy="13.5" r="2" fill="#fff"/>
            <rect x="8" y="17.4" width="8" height="1.6" rx=".8" fill="#1a8fd1"/>
          </svg>
        </div>
        <h3><%= trainingPrograms[0][0] %></h3>
        <p><%= trainingPrograms[0][1] %></p>
      </a>
      <div class="path-num">1</div>
      <div></div>
    </div>
  </div>

  <div class="path-row">
    <div class="path-node right">
      <div></div>
      <div class="path-num">2</div>
      <a class="path-card reveal" href="#khoa-hoc-danh-sach">
        <div class="path-icon tint-gold">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M12 5C10 3.8 6.8 3.5 4 4.2v14c2.8-.7 6-.4 8 .8 2-1.2 5.2-1.5 8-.8V4.2c-2.8-.7-6-.4-8 .8Z" fill="#0a3d66"/>
