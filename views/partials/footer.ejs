  </main>

  <div class="brand-marquee" aria-hidden="true">
    <div class="brand-marquee-track">
      <span>VSIA STEM</span><span>VSIA STEM</span><span>VSIA STEM</span><span>VSIA STEM</span><span>VSIA STEM</span><span>VSIA STEM</span><span>VSIA STEM</span><span>VSIA STEM</span>
      <span>VSIA STEM</span><span>VSIA STEM</span><span>VSIA STEM</span><span>VSIA STEM</span><span>VSIA STEM</span><span>VSIA STEM</span><span>VSIA STEM</span><span>VSIA STEM</span>
    </div>
  </div>

  <footer class="site-footer" id="lien-he">
    <div class="container footer-inner">
      <div class="footer-brand">
        <div class="logo"><%- include('logo') %></div>
        <div class="footer-legal">
          <p class="footer-legal-name">Công ty TNHH Học viện Đổi mới Sáng tạo STEM Việt Nam</p>
          <p class="footer-legal-intl">Vietnam STEM Innovation Academy Company Limited</p>
        </div>
      </div>

      <div class="footer-col">
        <h4>Liên kết nhanh</h4>
        <a href="/">Trang chủ</a>
        <a href="/khoa-hoc">Khoá học</a>
        <a href="/hinh-anh">Hình ảnh hoạt động</a>
        <a href="/tu-van-phong-lab">Tư vấn phòng Lab</a>
        <a href="/ngay-hoi-cuoc-thi">Ngày hội &amp; Cuộc thi</a>
        <a href="/giai-phap">Giải pháp</a>
