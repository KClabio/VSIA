  <div class="float-actions">
    <button type="button" class="float-btn float-btn-top" id="backToTop" title="Về đầu trang" aria-label="Về đầu trang">↑</button>
    <button type="button" class="float-btn float-btn-chat" id="chatToggleBtn" title="<%= txt('chat.button.title', 'Chat với trợ lý AI') %>" aria-label="<%= txt('chat.button.title', 'Chat với trợ lý AI') %>">
      <% if (siteLogo) { %><img src="<%= siteLogo %>" alt="VSIA"><% } else { %>💬<% } %>
    </button>
    <button type="button" class="float-btn float-btn-email" id="contactToggleBtn" title="<%= txt('contact.button.title', 'Đăng ký tư vấn') %>" aria-label="<%= txt('contact.button.title', 'Đăng ký tư vấn') %>">✉</button>
  </div>

  <div class="chat-panel" id="chatPanel">
    <div class="chat-panel-header">
      <span class="chat-panel-title">
        <span class="chat-avatar"><% if (siteLogo) { %><img src="<%= siteLogo %>" alt="VSIA"><% } else { %>💬<% } %></span>
        <%- ed('chat.title', 'Trợ lý VSIA') %>
      </span>
      <button type="button" id="chatPanelClose" aria-label="Đóng chat">✕</button>
    </div>
    <div class="chat-panel-messages" id="chatMessages">
      <div class="chat-msg chat-msg-bot"><%- ed('chat.greeting', 'Xin chào! Tôi là trợ lý ảo của VSIA 👋 Bạn cần tư vấn gì về khoá học, thiết kế phòng Lab hay ngày hội STEM không?', { multiline: true }) %></div>
    </div>
    <form class="chat-panel-input" id="chatForm">
      <input type="text" id="chatInput" placeholder="<%= txt('chat.input.placeholder', 'Nhập câu hỏi của bạn...') %>" autocomplete="off" maxlength="2000">
      <button type="submit" aria-label="Gửi">➤</button>
    </form>
  </div>

  <div class="contact-modal-overlay" id="contactOverlay">
    <div class="contact-modal">
      <button type="button" class="contact-modal-close" id="contactModalClose" aria-label="Đóng">✕</button>
      <div class="contact-modal-ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z"/></svg></div>
      <h3><%- ed('contact.modal.title', 'Đăng ký tư vấn') %></h3>
      <p><%- ed('contact.modal.lead', 'Để lại thông tin, đội ngũ VSIA sẽ liên hệ tư vấn cho bạn sớm nhất.', { multiline: true }) %></p>
      <form id="contactForm">
        <label><%- ed('contact.form.name.label', 'Họ tên') %>
          <div class="auth-input-wrap">
            <svg class="auth-input-ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21a8 8 0 0 0-16 0"/><circle cx="12" cy="7" r="4"/></svg>
            <input type="text" name="name" placeholder="<%= txt('contact.form.name.placeholder', 'Nguyễn Văn A') %>" required maxlength="200">
          </div>
        </label>
        <div class="auth-form-row">
          <label><%- ed('contact.form.phone.label', 'Số điện thoại') %>
            <div class="auth-input-wrap">
              <svg class="auth-input-ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
              <input type="tel" name="phone" placeholder="<%= txt('contact.form.phone.placeholder', '0912 345 678') %>" required maxlength="30">
            </div>
          </label>
          <label><%- ed('contact.form.email.label', 'Email') %>
            <div class="auth-input-wrap">
              <svg class="auth-input-ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
              <input type="email" name="email" placeholder="<%= txt('contact.form.email.placeholder', 'ten@email.com') %>" required maxlength="200">
            </div>
          </label>
        </div>
        <label><%- ed('contact.form.message.label', 'Nội dung cần tư vấn') %>
          <textarea name="message" rows="3" placeholder="<%= txt('contact.form.message.placeholder', 'Bạn cần hỗ trợ về vấn đề gì?') %>" required maxlength="2000"></textarea>
        </label>
        <p id="contactFormMsg" class="form-error" style="display:none;"></p>
        <button type="submit" class="btn btn-primary btn-lg" style="width:100%;"><%- ed('contact.form.submit', 'Gửi yêu cầu') %></button>
      </form>
    </div>
  </div>

  <%# Đèn báo tạm: chỉ in ra khi middleware loadSiteContent (bước 2a) đã nạp.
      Có typeof bảo vệ nên chạy được cả trên server chưa có bước 2a. Xoá khi xong toàn bộ 2b. %>
  <% if (typeof editMode !== "undefined") { %><!-- ce-ready --><% } %>
  <script src="/js/main.js"></script>
</body>
</html>
