      <% if (siteLogo) { %><img src="<%= siteLogo %>" alt="VSIA"><% } else { %>💬<% } %>
    </button>
    <button type="button" class="float-btn float-btn-email" id="contactToggleBtn" title="Đăng ký tư vấn" aria-label="Đăng ký tư vấn">✉</button>
