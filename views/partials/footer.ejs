    <div class="brand-marquee-track">
      <%# Dòng chữ chạy: lặp 16 lần cùng một khoá (2 hàng 8, giữ đúng như bản gốc).
          Sửa một ô là 15 ô còn lại tự đổi theo. %>
      <% for (let i = 0; i < 8; i++) { %><span><%- ed('footer.marquee.text', 'VSIA STEM') %></span><% } %>
      <% for (let i = 0; i < 8; i++) { %><span><%- ed('footer.marquee.text', 'VSIA STEM') %></span><% } %>
    </div>
  </div>

  <footer class="site-footer" id="lien-he">
    <div class="container footer-inner">
      <div class="footer-brand">
        <div class="logo"><%- include('logo') %></div>
        <div class="footer-legal">
          <p class="footer-legal-name"><%- ed('footer.legal.name', 'Công ty TNHH Học viện Đổi mới Sáng tạo STEM Việt Nam') %></p>
          <p class="footer-legal-intl"><%- ed('footer.legal.intl', 'Vietnam STEM Innovation Academy Company Limited') %></p>
        </div>
      </div>

      <div class="footer-col footer-social">
        <h4><%- ed('footer.social.heading', 'Kết nối với VSIA') %></h4>
        <a href="<%= lnk('footer.social.facebook.link', 'https://www.facebook.com/profile.php?id=61594252493879') %>" target="_blank" rel="noopener"<%- lnkAttr('footer.social.facebook.link') %>>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          <%- ed('footer.social.facebook.label', 'Fanpage Facebook') %>
        </a>
        <a href="<%= lnk('footer.social.group.link', 'https://www.facebook.com/share/g/1EyHzgKThb/') %>" target="_blank" rel="noopener"<%- lnkAttr('footer.social.group.link') %>>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <%- ed('footer.social.group.label', 'Nhóm Facebook') %>
        </a>
        <a href="<%= lnk('footer.social.youtube.link', 'https://www.youtube.com/@VSiA-taphuan') %>" target="_blank" rel="noopener"<%- lnkAttr('footer.social.youtube.link') %>>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><path d="M9.75 15.02 15.5 11.75 9.75 8.48z" fill="currentColor" stroke="none"/></svg>
          <%- ed('footer.social.youtube.label', 'Kênh YouTube') %>
        </a>
      </div>

      <div class="footer-col footer-contact">
        <h4><%- ed('footer.contact.heading', 'Liên hệ') %></h4>
        <a href="<%= lnk('footer.contact.phone.link', 'https://zalo.me/0862260526') %>" target="_blank" rel="noopener"<%- lnkAttr('footer.contact.phone.link') %>>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
          <%- ed('footer.contact.phone.label', '0862.26.05.26') %>
        </a>
        <a href="<%= lnk('footer.contact.website.link', 'https://www.vsia.edu.vn') %>" target="_blank" rel="noopener"<%- lnkAttr('footer.contact.website.link') %>>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>
          <%- ed('footer.contact.website.label', 'www.vsia.edu.vn') %>
        </a>
        <a href="<%= lnk('footer.contact.email.link', 'https://mail.google.com/mail/u/0/?fs=1&to=info%40vsia.edu.vn&tf=cm') %>" target="_blank" rel="noopener"<%- lnkAttr('footer.contact.email.link') %>>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
