<%# Nut hien/an mat khau.
    Cach dung: dat ngay SAU the input type="password", va them class "has-toggle" vao the
    div.auth-input-wrap boc ngoai (class do tao khoang trong ben phai cho nut).
    Xem vi du thuc te trong views/login.ejs va views/register.ejs.
    CSS: cuoi public/css/theme.css, muc "Nut hien/an mat khau".
    JS : cuoi public/js/main.js, bat su kien theo class .pw-toggle.
    Luu y: khong viet the EJS trong comment nay - EJS dong comment o dau cham phan tram dong
    dau tien nen se lam vo template. %>
<button type="button" class="pw-toggle" aria-pressed="false" aria-label="Hiện mật khẩu" title="Hiện mật khẩu">
  <svg class="pw-icon-on" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6-10-6-10-6Z"/>
    <circle cx="12" cy="12" r="3"/>
  </svg>
  <svg class="pw-icon-off" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M10.7 6.2A10.6 10.6 0 0 1 12 6c6.4 0 10 6 10 6a18.4 18.4 0 0 1-2.5 3.2M6.5 8.4C3.8 10.1 2 12 2 12s3.6 6 10 6c1.2 0 2.3-.2 3.3-.5"/>
    <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/>
    <path d="M3 3l18 18"/>
  </svg>
</button>
