<a href="/khoa-hoc/<%= course._id %>" class="course-card">
  <div class="course-thumb <%= course.image ? 'course-thumb-image' : '' %>" <% if (course.image) { %>style="background-image: url('<%= course.image %>');"<% } else { %>style="background: linear-gradient(135deg, hsl(<%= 140 + (course.title.length % 20) %>, 45%, <%= 22 + (course.title.length % 10) %>%), #072617);"<% } %>>
    <% if (!course.image) { %>
      <div class="hexlayer"><svg width="100%" height="100%"><rect width="100%" height="100%" fill="url(#hexpat)"/></svg></div>
    <% } %>
    <span class="course-cat"><%= course.category %></span>
  </div>
  <div class="course-body">
    <h3><%= course.title %></h3>
    <div class="course-meta-row">
      <span class="course-provider"><%= course.provider %></span>
      <span class="course-price <%= course.isFree ? 'is-free' : '' %>"><%= course.isFree ? 'Miễn phí' : course.price.toLocaleString('vi-VN') + ' đ' %></span>
    </div>
  </div>
</a>
