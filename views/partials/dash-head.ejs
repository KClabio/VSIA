<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' - VSIA' : 'VSIA - Học tập' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,500&family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>

<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
  <pattern id="hexpat" width="56" height="48" patternUnits="userSpaceOnUse">
    <path d="M28 0 L56 16 L56 48 M28 0 L0 16 L0 48 M0 16 L28 32 L56 16 M28 32 L28 64" fill="none" stroke="currentColor" stroke-width="1.3"/>
  </pattern>
</defs></svg>

<div class="dash-app">
  <aside class="dash-side">
    <a href="/" class="dash-brand"><%- include('logo') %></a>

    <nav class="dash-nav">
      <span class="dash-nav-lbl">Bảng điều khiển</span>
      <a href="/" class="dash-nav-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 11 12 3l9 8M5 9v11h5v-6h4v6h5V9"/></svg>
        Trang chủ
      </a>
      <a href="/khoa-hoc-cua-toi" class="dash-nav-item <%= typeof active !== 'undefined' && active === 'khoa-hoc-cua-toi' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 2 8l10 5 10-5-10-5Z"/><path d="M6 10.5V16c0 1.3 2.7 3 6 3s6-1.7 6-3v-5.5M20 8.5V15"/></svg>
        Khoá học của tôi
      </a>
      <a href="/nhiem-vu-hoc-tap" class="dash-nav-item <%= typeof active !== 'undefined' && active === 'nhiem-vu' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5"/></svg>
        Nhiệm vụ học tập
      </a>
      <a href="/ket-qua-hoc-tap" class="dash-nav-item <%= typeof active !== 'undefined' && active === 'ket-qua' ? 'active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 3v18h18M8 16V9m5 7V6m5 10v-4"/></svg>
        Kết quả học tập
      </a>
    </nav>

    <div class="dash-side-foot">
      <a href="/ho-so" class="dash-user">
        <span class="dash-user-av"><% if (user.avatar) { %><img src="<%= user.avatar %>" alt=""><% } else { %><%= user.name.charAt(0).toUpperCase() %><% } %></span>
        <span><span class="dash-user-nm"><%= user.name %></span><span class="dash-user-rl"><%= user.role === 'admin' ? 'Quản trị viên' : 'Giáo viên' %></span></span>
      </a>
    </div>
  </aside>

  <div class="dash-main">
    <div class="dash-topbar">
      <div class="dash-crumb">Bảng điều khiển &nbsp;/&nbsp; <b><%= pageTitle %></b></div>
      <div class="dash-top-right">
        <a href="/khoa-hoc" class="btn btn-primary">Khám phá khoá học</a>
      </div>
    </div>

    <div class="dash-content">
