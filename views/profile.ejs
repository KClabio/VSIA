<%- include('partials/header', { title: 'Hồ sơ - VSIA' }) %>

<section class="section auth-section">
  <div class="container auth-container">
    <div class="profile-card">
      <h1>Hồ sơ của tôi</h1>
      <dl class="profile-info">
        <dt>Họ tên</dt>
        <dd><%= user.name %></dd>
        <dt>Email</dt>
        <dd><%= user.email %></dd>
        <dt>Vai trò</dt>
        <dd><%= user.role === 'admin' ? 'Quản trị viên' : 'Giáo viên' %></dd>
        <dt>Ngày tham gia</dt>
        <dd><%= new Date(user.createdAt).toLocaleDateString('vi-VN') %></dd>
      </dl>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
