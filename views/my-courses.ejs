<%- include('partials/dash-head') %>

  <div class="dash-page-head">
    <div>
      <span class="eyebrow">Học tập</span>
      <h1>Khoá học của tôi</h1>
      <p>Theo dõi tiến độ và tiếp tục hành trình học STEM của bạn.</p>
    </div>
  </div>

  <div class="dash-stats">
    <div class="dash-stat a reveal">
      <div class="dash-stat-ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg></div>
      <div><div class="n"><%= summary.total %></div><div class="l">Khoá học đã đăng ký</div></div>
    </div>
    <div class="dash-stat a reveal">
      <div class="dash-stat-ic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 11.1V12a10 10 0 1 1-5.9-9.1"/><path d="M22 4 12 14.01l-3-3"/></svg></div>
      <div><div class="n"><%= summary.completedCount %></div><div class="l">Đã hoàn thành 100%</div></div>
    </div>
    <div class="dash-stat b reveal">
      <div class="dash-ring">
        <svg width="56" height="56"><circle cx="28" cy="28" r="24" fill="none" stroke="#eef4f0" stroke-width="6"/><circle cx="28" cy="28" r="24" fill="none" stroke="var(--gold)" stroke-width="6" stroke-linecap="round" stroke-dasharray="150.8" stroke-dashoffset="<%= (150.8 - 150.8 * summary.avgPercent / 100).toFixed(1) %>"/></svg>
        <span class="pct"><%= summary.avgPercent %>%</span>
      </div>
      <div><div class="n"><%= summary.avgPercent %>%</div><div class="l">Tiến độ trung bình</div></div>
    </div>
  </div>

  <% if (items.length === 0) { %>
    <div class="dash-empty reveal">
      <div class="dash-empty-glow"></div>
      <div class="dash-empty-art">
        <svg viewBox="0 0 132 132" fill="none">
          <circle cx="66" cy="66" r="60" fill="#eaf4fb"/>
          <rect x="34" y="46" width="64" height="46" rx="6" fill="#fff" stroke="#cfe0f5" stroke-width="2"/>
          <path d="M66 46v46" stroke="#cfe0f5" stroke-width="2"/>
          <path d="M40 56h20M40 64h20M40 72h14M72 56h20M72 64h20M72 72h14" stroke="#a9c9e8" stroke-width="2.4" stroke-linecap="round"/>
          <circle cx="98" cy="44" r="15" fill="#1a8fd1"/>
          <path d="M92 44h12M98 38v12" stroke="#fff" stroke-width="2.6" stroke-linecap="round"/>
          <path d="M30 40l4-2 2-4 2 4 4 2-4 2-2 4-2-4z" fill="#d8a13a"/>
        </svg>
      </div>
      <h3>Bạn chưa đăng ký khoá học nào</h3>
      <p>Khám phá các khoá đào tạo STEM miễn phí của VSIA và bắt đầu hành trình học tập của bạn ngay hôm nay.</p>
      <a href="/khoa-hoc" class="btn btn-primary">Xem danh sách khoá học →</a>
    </div>
  <% } else { %>
    <div class="dash-sec-title">
      <h2>Khoá học đã đăng ký</h2>
    </div>
    <div class="dash-enrolled-list">
      <% items.forEach(item => { const course = item.course; %>
        <div class="dash-enrolled-card reveal">
          <div class="thumb" <% if (course.image) { %>style="background-image:url('<%= course.image %>');"<% } else { %>style="background: linear-gradient(135deg, hsl(<%= 205 + (course.title.length % 20) %>, 55%, 30%), #062544);"<% } %>>
            <% if (!course.image) { %><div class="hex"><svg width="100%" height="100%"><rect width="100%" height="100%" fill="url(#hexpat)"/></svg></div><% } %>
          </div>
          <div class="info">
            <h4><%= course.title %></h4>
            <% if (course.instructor) { %>
              <div class="instructor"><span class="av">👤</span> Giảng viên: <%= course.instructor %></div>
            <% } %>
            <% if (course.studyPeriod || course.examDate) { %>
              <div class="meta-row">
                <% if (course.studyPeriod) { %><div><span class="lbl">Thời gian học:</span><%= course.studyPeriod %></div><% } %>
                <% if (course.examDate) { %><div><span class="lbl">Ngày thi dự kiến:</span><%= course.examDate %></div><% } %>
              </div>
            <% } %>
            <div class="progress-wrap">
              <span class="progress-label">Hoàn thành <%= item.stats.percent %>%</span>
              <div class="player-progress-track"><div class="player-progress-fill" style="width:<%= item.stats.percent %>%;"></div></div>
            </div>
          </div>
          <div class="action">
            <a href="/hoc/<%= course._id %>" class="btn btn-primary">Học ngay</a>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <% if (suggested.length > 0) { %>
    <div class="dash-sec-title" id="courses">
      <h2>Khoá học gợi ý cho bạn</h2>
      <a href="/khoa-hoc">Xem tất cả →</a>
    </div>
    <div class="dash-courses">
      <% suggested.forEach(course => {
        const lessonCount = (course.modules || []).reduce((sum, m) => sum + (m.lessons || []).length, 0);
      %>
        <a href="/khoa-hoc/<%= course._id %>" class="dash-course reveal">
          <div class="top" <% if (course.image) { %>style="background-image:url('<%= course.image %>');"<% } else { %>style="background: linear-gradient(135deg, hsl(<%= 205 + (course.title.length % 20) %>, 55%, 30%), #062544);"<% } %>>
            <% if (!course.image) { %><div class="hex"><svg width="100%" height="100%"><rect width="100%" height="100%" fill="url(#hexpat)"/></svg></div><% } %>
            <span class="cat"><%= course.category %></span>
            <span class="lv"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg><%= lessonCount %> bài</span>
          </div>
          <div class="body">
            <h4><%= course.title %></h4>
            <div class="meta">
              <span class="free"><%= course.isFree ? 'Miễn phí' : course.price.toLocaleString('vi-VN') + ' đ' %></span>
              <span class="go"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>

<%- include('partials/dash-foot') %>
