<%- include('partials/header', { title: article.title + ' - VSIA' }) %>

<section class="section">
  <div class="container article-detail">
    <a href="/tin-tuc" class="article-back">← Tất cả bài viết</a>
    <h1><%= article.title %></h1>
    <p class="article-detail-date"><%= new Date(article.createdAt).toLocaleDateString('vi-VN') %></p>

    <% if (article.image) { %>
      <div class="article-detail-image" style="background-image: url('<%= article.image %>');"></div>
    <% } else { %>
      <% const pal = [['#1a5a2e','#0a2618'],['#5b2a8c','#20103a'],['#8c3a2a','#3a140d'],['#145c37','#072617']][article.title.length % 4]; %>
      <div class="article-detail-image" style="background: linear-gradient(135deg, <%= pal[0] %>, <%= pal[1] %>);">
        <div class="hexlayer"><svg width="100%" height="100%"><rect width="100%" height="100%" fill="url(#hexpat)"/></svg></div>
      </div>
    <% } %>

    <p class="article-detail-content"><%= article.content %></p>

    <% if (article.sourceUrl) { %>
      <p class="article-source">
        Nguồn: <a href="<%= article.sourceUrl %>" target="_blank" rel="noopener noreferrer nofollow"><%= article.sourceUrl %></a>
      </p>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
