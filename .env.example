PORT=3000
MONGO_URI=mongodb://localhost:27017/vsia_db
SESSION_SECRET=change-this-to-a-random-secret
GEMINI_API_KEY=AIzaSy...
# Chỉ set khi deploy sau reverse proxy thật (Nginx/Vercel/Render...), vd TRUST_PROXY=1
TRUST_PROXY=
# Bắt buộc điền khi deploy lên nền tảng ổ đĩa tạm thời (Render/Railway/Heroku/Vercel...) — tạo
# tài khoản miễn phí tại cloudinary.com, lấy 3 giá trị này ở Dashboard. Để trống khi chạy local
# thì file upload vẫn lưu đĩa cục bộ như cũ, không bắt buộc phải có Cloudinary để dev.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
